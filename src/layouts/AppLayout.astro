---
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Terminal workspace',
	description = 'Manage persistent terminal sessions from CmdImpact.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#151a23" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{title + ' - CmdImpact'}</title>
	</head>
	<body class="app-body">
		<a class="skip-link" href="#terminal-workspace">Skip to terminal</a>
		<header class="app-topbar">
			<a class="brand app-brand" href="/" aria-label="CmdImpact home"><Logo /></a>
			<div class="app-product-label"><span>Self-hosted alpha</span><strong>Terminal workspace</strong></div>
			<div class="app-top-actions">
				<button id="runner-button" class="runner-button" type="button" aria-label="Change terminal runner">
					<i aria-hidden="true"></i>
					<span><small>Runner</small><strong id="runner-origin">Not connected</strong></span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 5 5-5 5"/></svg>
				</button>
				<span id="global-connection" class="connection-pill" data-state="idle"><i></i><span>Not connected</span></span>
				<button id="new-session-top" class="app-primary" type="button">New session</button>
				<button id="logout-button" class="icon-button" type="button" title="Sign out" aria-label="Sign out">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5v14h5M14 8l4 4-4 4M9 12h9"/></svg>
				</button>
			</div>
		</header>
		<slot />
	</body>
</html>
