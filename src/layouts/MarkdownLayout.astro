---
import AdSlot from '../components/AdSlot.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const allowAds = frontmatter.ads === true;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
	<header class="page-hero">
		<div class="shell narrow">
			<p class="kicker">CmdImpact / {frontmatter.section || 'Trust center'}</p>
			<h1>{frontmatter.title}</h1>
			<p class="page-lede">{frontmatter.description}</p>
		</div>
	</header>
	<article class="shell narrow prose"><slot /></article>
	{allowAds && <div class="shell narrow"><AdSlot /></div>}
</BaseLayout>
