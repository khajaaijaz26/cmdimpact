---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noIndex?: boolean;
	allowAds?: boolean;
}

const { title, description, noIndex = false, allowAds = false } = Astro.props;
const pageTitle = title === 'CmdImpact' ? title : `${title} · CmdImpact`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-card.png', Astro.site);
const adsenseClient = allowAds ? import.meta.env.PUBLIC_ADSENSE_CLIENT : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#13110f" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		{noIndex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CmdImpact" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="CmdImpact — understand commands before running them." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('cmdimpact-theme');
				const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = saved || preferred;
			})();
		</script>
		{adsenseClient && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>}
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Header />
		<main id="main-content"><slot /></main>
		<Footer />
	</body>
</html>
