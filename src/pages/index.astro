---
import { getCollection } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { coverageAreas, passportGroups } from '../data/coverage';

const products = (await getCollection('products')).map((entry) => entry.data);
const featuredProducts = ['aqara-smart-video-doorbell-g4', 'eufy-video-doorbell-e340', 'ring-battery-doorbell-2k-plus']
	.map((id) => products.find((product) => product.id === id))
	.filter(Boolean);
const guides = (await getCollection('guides')).filter((guide) => guide.data.featured).slice(0, 2);
const platformCount = new Set(passportGroups.flatMap((group) => group.items.map((item) => item[0]))).size;
---

<BaseLayout title="CompatNavi" description="A worldwide compatibility layer for technology. Map your market, platforms and connections, then find products that fit before you buy.">
	<section class="universe-hero">
		<div class="container universe-grid">
			<div class="hero-copy">
				<div class="scope-line"><span class="live-pulse"></span> Universal compatibility · Honest coverage</div>
				<p class="eyebrow">The compatibility layer for technology</p>
				<h1>Make all your tech <span>work together.</span></h1>
				<p class="lede">CompatNavi maps your country, platforms, ports and preferences—then turns scattered technical facts into a clear answer before you buy.</p>
				<div class="button-row">
					<a class="button" href="/passport/">Build my Tech Passport <span aria-hidden="true">→</span></a>
					<a class="button secondary" href="/categories/">Explore the technology atlas</a>
				</div>
				<div class="hero-proof"><span>Private by default</span><span>Official sources</span><span>Worldwide profile</span></div>
			</div>

			<div class="network-console" aria-label="A compatibility network connecting common technology platforms">
				<div class="console-head"><span><i class="live-pulse"></i> COMPATIBILITY NETWORK</span><span>CN–01</span></div>
				<div class="network-stage">
					<div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div>
					<div class="network-core"><span>CN</span><small>YOUR<br />PASSPORT</small></div>
					<span class="network-node node-windows">Windows</span>
					<span class="network-node node-ios">iPhone</span>
					<span class="network-node node-android">Android</span>
					<span class="network-node node-home">Apple Home</span>
					<span class="network-node node-gaming">PlayStation</span>
					<span class="network-node node-usbc">USB-C</span>
				</div>
				<div class="console-data"><div><span>MARKET</span><strong>Any country</strong></div><div><span>SYSTEMS</span><strong>{platformCount} tracked</strong></div><div><span>PROFILE</span><strong>Local only</strong></div></div>
			</div>
		</div>
	</section>

	<section class="platform-rail" aria-label="Platforms and standards supported by the universal profile">
		<div class="container"><span>WINDOWS</span><i></i><span>ANDROID</span><i></i><span>APPLE HOME</span><i></i><span>MATTER</span><i></i><span>PLAYSTATION</span><i></i><span>USB-C</span><i></i><span>LINUX</span><i></i><span>HDMI</span></div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head split-head"><div><p class="eyebrow">Technology atlas</p><h2>One destination. Every category.</h2></div><div><p>The universal profile is ready now. Verified product coverage grows carefully, one category at a time.</p><a class="text-link" href="/categories/">View full coverage map <span aria-hidden="true">↗</span></a></div></div>
			<div class="home-category-grid">
				{coverageAreas.slice(0, 6).map((area, index) => (
					<a class:list={['home-category', area.status === 'live' && 'is-live']} href={area.status === 'live' ? '/products/' : `/categories/#${area.id}`}>
						<span class="category-mark" aria-hidden="true">{area.mark}</span><span class:list={['status-pill', area.status]}>{area.statusLabel}</span>
						<small>0{index + 1}</small><h3>{area.name}</h3><p>{area.scope}</p><span class="category-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="section passport-showcase">
		<div class="container passport-showcase-grid">
			<div class="passport-demo" aria-hidden="true">
				<div class="demo-top"><span>COMPATNAVI / CN</span><span>LOCAL</span></div>
				<div class="demo-globe"><span>◎</span><i class="globe-line one"></i><i class="globe-line two"></i></div>
				<p>TECH PASSPORT</p><h3>YOUR WORLD,<br />MAPPED.</h3>
				<div class="demo-tags"><span>UAE</span><span>ANDROID</span><span>WINDOWS</span><span>USB-C</span></div>
			</div>
			<div class="showcase-copy">
				<p class="eyebrow">The founder idea</p>
				<h2>A compatibility passport that travels across categories.</h2>
				<p>Most comparison sites start over with every search. CompatNavi remembers the world your technology must join—your market, operating systems, ecosystems and connections—without requiring an account.</p>
				<ul class="signal-list"><li><span>01</span><div><strong>Set it once</strong><p>Build one reusable profile in your browser.</p></div></li><li><span>02</span><div><strong>Use only what matters</strong><p>Each checker reads the relevant parts of your setup.</p></div></li><li><span>03</span><div><strong>Keep uncertainty visible</strong><p>Unsupported and undocumented are never treated as the same thing.</p></div></li></ul>
				<a class="button" href="/passport/">Create my passport</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head"><div><p class="eyebrow">Utility deck</p><h2>Three tools. No account.</h2><p>Useful answers first; ads stay outside controls and never decide rankings.</p></div><a class="text-link" href="/tools/">Open all tools <span aria-hidden="true">→</span></a></div>
			<div class="home-tools">
				<a class="home-tool tool-main" href="/check/"><span class="tool-seq">01 / MATCH</span><span class="tool-symbol">✓</span><div><h3>Compatibility checker</h3><p>Rank the live catalog against your actual setup and expose hard blockers before checkout.</p><strong>Run checker →</strong></div></a>
				<a class="home-tool" href="/compare/"><span class="tool-seq">02 / COMPARE</span><span class="tool-symbol">⇄</span><div><h3>Compare products</h3><p>Put decision-changing facts side by side.</p><strong>Start comparison →</strong></div></a>
				<a class="home-tool" href="/cost/"><span class="tool-seq">03 / COST</span><span class="tool-symbol">¤</span><div><h3>True ownership cost</h3><p>Calculate in your currency, across years.</p><strong>Calculate cost →</strong></div></a>
			</div>
		</div>
	</section>

	<section class="section live-lab">
		<div class="container">
			<div class="live-lab-head"><div><span class="live-tag"><i class="live-pulse"></i> LIVE VERIFIED CATEGORY</span><p class="eyebrow">Smart home / Video doorbells</p><h2>The first proving ground.</h2><p>{products.length} products checked for power, networks, platforms, storage, subscriptions and outage behavior.</p></div><div class="lab-stat"><strong>{products.length}</strong><span>models with direct<br />manufacturer sources</span></div></div>
			<div class="product-grid">{featuredProducts.map((product) => product && <ProductCard product={product} />)}</div>
			<div class="section-action"><a class="button secondary" href="/products/">Browse all {products.length} verified products</a></div>
			<AdSlot />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head"><div><p class="eyebrow">Decision library</p><h2>Understand the detail behind the verdict.</h2></div><a class="text-link" href="/guides/">Browse all guides <span aria-hidden="true">→</span></a></div>
			<div class="guide-grid">
				{guides.map((guide) => <article class="guide-card"><div class="guide-meta"><span>{guide.data.readingTime}</span><span>Updated {guide.data.updatedAt.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span></div><h2><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h2><p>{guide.data.description}</p><a class="text-link" href={`/guides/${guide.id}/`}>Read field note <span aria-hidden="true">↗</span></a></article>)}
			</div>
		</div>
	</section>
</BaseLayout>
