---
import { getCollection } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import ProductCard from '../components/ProductCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const products = (await getCollection('products')).map((entry) => entry.data);
const featuredProducts = ['aqara-smart-video-doorbell-g4', 'eufy-video-doorbell-e340', 'ring-battery-doorbell-2k-plus']
	.map((id) => products.find((product) => product.id === id))
	.filter(Boolean);
const guides = (await getCollection('guides')).filter((guide) => guide.data.featured).slice(0, 2);
---

<BaseLayout title="CompatNavi" description="Check whether smart home technology fits your Wi-Fi, wiring, ecosystem, storage preferences and budget before you buy.">
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Compatibility, made human</p>
				<h1>Find the tech that <span>fits.</span></h1>
				<p class="lede">Stop opening ten tabs just to learn whether a device works with your home. CompatNavi turns verified manufacturer facts into a clear answer before you spend.</p>
				<div class="button-row">
					<a class="button" href="/check/">Check my setup <span aria-hidden="true">→</span></a>
					<a class="button secondary" href="/products/">Browse verified products</a>
				</div>
				<div class="trust-line" aria-label="CompatNavi principles">
					<span>Manufacturer sources</span>
					<span>Unknown means unknown</span>
					<span>No sponsored rankings</span>
				</div>
			</div>
			<div class="fit-map" aria-label="Illustration of four setup requirements leading to a fit verdict">
				<div class="map-path" aria-hidden="true"></div>
				<div class="map-node node-one">2.4 + 5 GHz</div>
				<div class="map-node node-two">Apple Home</div>
				<div class="map-node node-three">Local storage</div>
				<div class="map-node node-four">Battery power</div>
				<div class="map-center" aria-hidden="true">
					<svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18"/><path d="m15 25 6 6 13-16M34 15v8"/></svg>
				</div>
				<div class="map-verdict"><strong>Fits your setup</strong><span>4 requirements checked</span></div>
			</div>
		</div>
	</section>

	<div class="container">
		<div class="proof-strip" aria-label="Launch catalog statistics">
			<div><strong>{products.length} products</strong><span>Doorbells checked at launch</span></div>
			<div><strong>5 fit signals</strong><span>Power, network, platform, storage, resilience</span></div>
			<div><strong>Source-first</strong><span>Every product links to evidence and a review date</span></div>
		</div>
	</div>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">How it works</p>
					<h2>A decision, not another spec sheet.</h2>
					<p>CompatNavi compares the setup you already have with the requirements manufacturers actually publish.</p>
				</div>
			</div>
			<div class="card-grid">
				<article class="feature-card"><span class="feature-number">01</span><h3>Describe your setup</h3><p>Choose your power, network, smart-home platform, storage preference and tolerance for subscriptions.</p></article>
				<article class="feature-card"><span class="feature-number">02</span><h3>See the mismatch</h3><p>Hard blockers, tradeoffs and missing manufacturer information appear separately—without hiding the awkward parts.</p></article>
				<article class="feature-card"><span class="feature-number">03</span><h3>Verify the evidence</h3><p>Open the cited manufacturer pages, see when they were checked, and make the final call with context.</p></article>
			</div>
		</div>
	</section>

	<section class="section tint">
		<div class="container">
			<div class="section-head"><div><p class="eyebrow">Free tools</p><h2>Useful before and after the shortlist.</h2></div></div>
			<div class="card-grid">
				<article class="tool-card"><span class="tool-icon">✓</span><h3>Personal fit checker</h3><p>Rank products against the constraints of your own home and save the profile only in this browser.</p><a class="text-link" href="/check/">Check compatibility <span aria-hidden="true">→</span></a></article>
				<article class="tool-card"><span class="tool-icon">⇄</span><h3>Plain-English compare</h3><p>Put two products side by side across the facts that change whether they will work for you.</p><a class="text-link" href="/compare/">Compare products <span aria-hidden="true">→</span></a></article>
				<article class="tool-card"><span class="tool-icon">$</span><h3>True cost calculator</h3><p>Add hardware, installation, storage and subscriptions to see the real ownership cost over time.</p><a class="text-link" href="/cost/">Calculate true cost <span aria-hidden="true">→</span></a></article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<div><p class="eyebrow">Start here</p><h2>Three different ways to secure the door.</h2><p>These examples reveal why “best” depends on the setup: cloud-first, local-first and ecosystem-first products solve different problems.</p></div>
				<a class="text-link" href="/products/">View all {products.length} products <span aria-hidden="true">→</span></a>
			</div>
			<div class="product-grid">
				{featuredProducts.map((product) => product && <ProductCard product={product} />)}
			</div>
			<AdSlot />
		</div>
	</section>

	<section class="section tint">
		<div class="container">
			<div class="section-head">
				<div><p class="eyebrow">Decision guides</p><h2>Learn the questions worth asking.</h2><p>Short, practical explanations for the compatibility details product pages tend to scatter.</p></div>
				<a class="text-link" href="/guides/">All guides <span aria-hidden="true">→</span></a>
			</div>
			<div class="guide-grid">
				{guides.map((guide) => (
					<article class="guide-card">
						<div class="guide-meta"><span>{guide.data.readingTime}</span><span>Updated {guide.data.updatedAt.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span></div>
						<h2><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h2>
						<p>{guide.data.description}</p>
						<a class="text-link" href={`/guides/${guide.id}/`}>Read guide <span aria-hidden="true">→</span></a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container cta-band">
			<div><h2>Start with your home, not the hype.</h2><p>Your profile stays on your device and takes about a minute to complete.</p></div>
			<a class="button" href="/check/">Find my fit</a>
		</div>
	</section>
</BaseLayout>
