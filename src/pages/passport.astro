---
import BaseLayout from '../layouts/BaseLayout.astro';
import { passportGroups } from '../data/coverage';

const platformLabels = Object.fromEntries(passportGroups.flatMap((group) => group.items));
const serializedLabels = JSON.stringify(platformLabels).replaceAll('<', '\\u003c');
---

<BaseLayout title="My Tech Passport" description="Create a private, reusable compatibility profile for your country, currency, platforms and connections.">
	<section class="page-hero passport-hero">
		<div class="container page-hero-grid">
			<div><p class="eyebrow">Your universal profile</p><h1>One setup. Every tech decision.</h1></div>
			<p class="lede">Tell CompatNavi what world your technology lives in. Your passport stays on this device and future category tools can use only the details they need.</p>
		</div>
	</section>

	<section class="container passport-layout">
		<form id="passport-form" class="passport-form">
			<section class="passport-section">
				<div class="passport-section-head"><span>01</span><div><h2>Your market</h2><p>Regional models, power rules, services and prices can differ.</p></div></div>
				<div class="field-grid three-fields">
					<div class="form-field"><label for="country">Country or market</label><input id="country" name="country" type="text" autocomplete="country-name" placeholder="Type any country" maxlength="80" /></div>
					<div class="form-field"><label for="region">World region</label><select id="region" name="region"><option value="global">Global / multiple regions</option><option value="africa">Africa</option><option value="asia">Asia</option><option value="europe">Europe</option><option value="middle-east">Middle East</option><option value="north-america">North America</option><option value="latin-america">Latin America & Caribbean</option><option value="oceania">Oceania</option></select></div>
					<div class="form-field"><label for="currency">Preferred currency</label><select id="currency" name="currency"><option>USD</option><option>AED</option><option>AUD</option><option>BRL</option><option>CAD</option><option>CHF</option><option>CNY</option><option>EUR</option><option>GBP</option><option>INR</option><option>JPY</option><option>KRW</option><option>NGN</option><option>NZD</option><option>SAR</option><option>SGD</option><option>ZAR</option></select></div>
				</div>
			</section>

			<section class="passport-section">
				<div class="passport-section-head"><span>02</span><div><h2>Your technology</h2><p>Select everything that a new device or service may need to work with.</p></div></div>
				<div class="platform-groups">
					{passportGroups.map((group) => (
						<fieldset class="platform-group">
							<legend>{group.name}</legend>
							<div class="platform-options">
								{group.items.map(([value, label]) => (
									<label class="platform-option"><input type="checkbox" name="platforms" value={value} /><span>{label}</span></label>
								))}
							</div>
						</fieldset>
					))}
				</div>
			</section>

			<div class="passport-actions">
				<button class="button" type="submit">Save passport</button>
				<button class="button secondary" id="copy-passport" type="button">Copy summary</button>
				<button class="text-button" id="reset-passport" type="button">Clear</button>
				<span id="passport-status" class="save-status" role="status" aria-live="polite"></span>
			</div>
			<p class="privacy-note">Stored only in this browser. CompatNavi has no account or profile database.</p>
		</form>

		<aside class="tech-passport-card" aria-label="Tech Passport preview">
			<div class="passport-card-top"><span>COMPATNAVI / CN</span><span class="passport-chip">LOCAL</span></div>
			<div class="passport-orbit" aria-hidden="true"><span>CN</span><i></i><i></i><i></i></div>
			<p class="passport-label">MARKET</p><strong id="preview-market">Worldwide</strong>
			<div class="passport-card-grid">
				<div><span>Region</span><strong id="preview-region">Global</strong></div>
				<div><span>Currency</span><strong id="preview-currency">USD</strong></div>
				<div><span>Systems</span><strong id="preview-count">0</strong></div>
			</div>
			<div id="preview-platforms" class="passport-platforms"><span>Add your platforms</span></div>
			<p class="passport-id">PRIVATE PROFILE · THIS DEVICE ONLY</p>
		</aside>
	</section>

	<section class="section"><div class="container passport-next"><div><p class="eyebrow">First live use</p><h2>Take your smart-home platform into the checker.</h2><p>If your passport contains one supported home platform, the current video-doorbell checker can prefill it.</p></div><a class="button secondary" href="/check/">Open compatibility checker</a></div></section>

	<script is:inline id="passport-labels" type="application/json" set:html={serializedLabels}></script>
	<script>
		import { summarizePassport, type TechPassport } from '../lib/passport';

		const form = document.querySelector<HTMLFormElement>('#passport-form');
		const status = document.querySelector<HTMLElement>('#passport-status');
		const labels = JSON.parse(document.querySelector('#passport-labels')?.textContent || '{}') as Record<string, string>;
		const storageKey = 'compatnavi-passport-v1';

		function readForm(): TechPassport {
			const data = new FormData(form || undefined);
			return {
				country: String(data.get('country') || ''),
				region: String(data.get('region') || 'global'),
				currency: String(data.get('currency') || 'USD'),
				platforms: data.getAll('platforms').map(String),
			};
		}

		function render() {
			const passport = readForm();
			const summary = summarizePassport(passport);
			const region = (form?.elements.namedItem('region') as HTMLSelectElement | null)?.selectedOptions[0]?.text || 'Global';
			const set = (selector: string, value: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = value; };
			set('#preview-market', summary.market);
			set('#preview-region', region);
			set('#preview-currency', passport.currency);
			set('#preview-count', String(summary.platformCount).padStart(2, '0'));
			const list = document.querySelector<HTMLElement>('#preview-platforms');
			if (list) {
				list.textContent = '';
				for (const item of summary.platforms.slice(0, 8)) {
					const chip = document.createElement('span');
					chip.textContent = labels[item] || item;
					list.append(chip);
				}
				if (!summary.platformCount) { const empty = document.createElement('span'); empty.textContent = 'Add your platforms'; list.append(empty); }
			}
		}

		function restore() {
			if (!form) return;
			try {
				const saved = JSON.parse(localStorage.getItem(storageKey) || 'null') as TechPassport | null;
				if (!saved) return;
				const country = form.elements.namedItem('country') as HTMLInputElement;
				const region = form.elements.namedItem('region') as HTMLSelectElement;
				const currency = form.elements.namedItem('currency') as HTMLSelectElement;
				country.value = typeof saved.country === 'string' ? saved.country : '';
				if ([...region.options].some((option) => option.value === saved.region)) region.value = saved.region;
				if ([...currency.options].some((option) => option.value === saved.currency)) currency.value = saved.currency;
				for (const checkbox of form.querySelectorAll<HTMLInputElement>('input[name="platforms"]')) checkbox.checked = Array.isArray(saved.platforms) && saved.platforms.includes(checkbox.value);
			} catch { localStorage.removeItem(storageKey); }
		}

		form?.addEventListener('input', render);
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			localStorage.setItem(storageKey, JSON.stringify(readForm()));
			if (status) status.textContent = 'Saved on this device.';
		});
		document.querySelector('#reset-passport')?.addEventListener('click', () => {
			form?.reset();
			localStorage.removeItem(storageKey);
			if (status) status.textContent = 'Passport cleared.';
			render();
		});
		document.querySelector('#copy-passport')?.addEventListener('click', async () => {
			const passport = readForm();
			const summary = summarizePassport(passport);
			const text = `CompatNavi Tech Passport — ${summary.market}; ${passport.region}; ${passport.currency}; ${summary.platforms.map((item) => labels[item] || item).join(', ') || 'no platforms selected'}`;
			try { await navigator.clipboard.writeText(text); if (status) status.textContent = 'Summary copied.'; }
			catch { if (status) status.textContent = 'Copy was blocked by this browser.'; }
		});

		restore();
		render();
	</script>
</BaseLayout>
