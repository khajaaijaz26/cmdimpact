---
import AppLayout from '../../layouts/AppLayout.astro';

const remoteDashboardOrigin = Astro.site?.protocol === 'https:' ? Astro.site.origin : 'https://cmdimpact.vercel.app';
---

<AppLayout>
	<div id="terminal-workspace" class="terminal-app">
		<button id="sidebar-scrim" class="sidebar-scrim" type="button" aria-label="Close sessions"></button>
		<aside id="session-sidebar" class="session-sidebar" aria-label="Terminal sessions">
			<div class="session-sidebar-title">
				<div><span>Connected runner</span><h1>Sessions</h1></div>
				<button id="new-session-side" class="round-button" type="button" title="New session" aria-label="New session">+</button>
			</div>
			<div class="sidebar-explainer">
				<strong>These are sessions on this runner.</strong>
				<span>Detached means no browser is attached; the session can keep running.</span>
			</div>
			<div id="session-list" class="session-list" aria-live="polite">
				<div class="session-loading"><span></span><span></span><span></span></div>
			</div>
			<div class="session-sidebar-foot">
				<span id="runner-dot" class="server-dot" data-state="idle" aria-hidden="true"></span>
				<div><strong id="sidebar-runner">CmdImpact runner</strong><small id="server-status">Checking connection...</small></div>
			</div>
		</aside>

		<main class="terminal-main">
			<section id="workspace-empty" class="workspace-empty">
				<div class="empty-mark" aria-hidden="true">ci_</div>
				<p class="app-kicker">RUNNER ONLINE</p>
				<h2>Create a terminal session.</h2>
				<p>Choose a shell on the connected runner. It appears in Sessions and can continue without this browser while the runner stays online.</p>
				<div class="empty-actions"><button id="new-session-empty" class="app-primary large" type="button">Create session</button><button class="empty-help-button" type="button" data-open-tools>How CmdImpact works</button></div>
				<small>Runner restarts end live sessions; workspace files can persist.</small>
			</section>

			<section id="active-workspace" class="active-workspace" hidden>
				<header class="terminal-toolbar">
					<button id="sidebar-toggle" class="icon-button mobile-only" type="button" aria-label="Open sessions" aria-controls="session-sidebar" aria-expanded="false">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
					</button>
					<div class="session-identity">
						<div><h2 id="active-session-name">Terminal</h2><span id="active-session-meta">live session</span></div>
					</div>
					<div class="terminal-actions">
						<button id="open-tools" class="toolbar-button" type="button" data-open-tools>Help &amp; tools</button>
						<button id="rename-session" class="toolbar-button" type="button">Rename</button>
						<button id="take-control" class="toolbar-button control" type="button" hidden>Take control</button>
						<button id="reconnect-session" class="toolbar-button" type="button" hidden>Reconnect</button>
						<button id="end-session" class="toolbar-button danger" type="button">End</button>
					</div>
				</header>
				<div class="terminal-frame">
					<div id="terminal" class="terminal-mount" aria-label="Interactive terminal"></div>
					<div id="terminal-overlay" class="terminal-overlay" hidden>
						<div class="overlay-spinner"></div>
						<strong id="terminal-overlay-title">Connecting...</strong>
						<span id="terminal-overlay-detail">Opening the session on this runner.</span>
					</div>
				</div>
				<div class="mobile-keybar" aria-label="Terminal shortcut keys">
					<button type="button" data-key="escape">esc</button>
					<button type="button" data-key="control-c">ctrl+c</button>
					<button type="button" data-key="tab">tab</button>
					<button type="button" data-key="up">&uarr;</button>
					<button type="button" data-key="down">&darr;</button>
					<button type="button" data-key="left">&larr;</button>
					<button type="button" data-key="right">&rarr;</button>
				</div>
				<footer class="terminal-statusbar">
					<span id="terminal-connection" data-state="idle"><i></i>Not connected</span>
					<span id="terminal-size">- x -</span>
					<span class="status-boundary">Browser disconnects keep the process running</span>
				</footer>
			</section>
		</main>
	</div>

	<dialog id="login-screen" class="login-screen" aria-labelledby="login-heading" aria-describedby="login-copy">
		<div class="login-card">
			<a class="login-home" href="/" aria-label="Back to CmdImpact"><span>ci_</span>cmdimpact</a>
			<p class="app-kicker">BROWSER TERMINAL SETUP</p>
			<h1 id="login-heading">Let's open your terminal.</h1>
			<p id="login-copy">Choose one path below. For local use, paste one private token; the runner address is filled for you. Remote use has its own guided steps.</p>

			<h2 id="setup-path-heading" class="setup-path-heading">What do you want to do?</h2>
			<div class="setup-paths" role="group" aria-labelledby="setup-path-heading">
				<button type="button" data-setup-path="local" aria-controls="setup-local" aria-pressed="true"><span>01 &middot; EASIEST</span><strong>Use this computer</strong><small>First-time setup</small></button>
				<button type="button" data-setup-path="remote" aria-controls="setup-remote" aria-pressed="false"><span>02 &middot; PRIVATE</span><strong>Phone or another device</strong><small>Remote access</small></button>
				<button type="button" data-setup-path="connect" aria-controls="setup-connect" aria-pressed="false"><span>03 &middot; READY</span><strong>I already set it up</strong><small>Address + token</small></button>
			</div>

			<div class="setup-panels">
				<section id="setup-local" class="setup-path-panel" data-setup-panel="local" aria-labelledby="local-setup-heading">
					<div class="setup-panel-heading"><span>RECOMMENDED</span><div><h2 id="local-setup-heading">Set up this computer</h2><p>Do these four steps in order. It usually takes a few minutes.</p></div></div>
					<ol class="guided-steps">
						<li><span>1</span><div><h3>Install the requirements once</h3><p>Install <a href="https://git-scm.com/downloads" rel="external noopener">Git</a>, <a href="https://nodejs.org/en/download/" rel="external noopener">Node.js 22.12 or newer</a>, and <a href="https://docs.docker.com/get-started/get-docker/" rel="external noopener">Docker Desktop</a> on Windows/macOS or Docker Engine with Compose on Linux. Start Docker and wait until it is running. CmdImpact sessions use an isolated Linux workspace inside Docker.</p></div></li>
						<li><span>2</span><div><h3>Open Terminal or PowerShell</h3><p>Copy and run these commands on the computer where your terminal should run.</p><div class="setup-code-block" data-code-block><div><small>TERMINAL / POWERSHELL</small><button type="button" data-copy-code aria-label="Copy local setup commands">Copy</button></div><pre><code>git clone https://github.com/khajaaijaz26/cmdimpact.git
cd cmdimpact
npm run setup</code></pre><span data-copy-status role="status" aria-live="polite"></span></div></div></li>
						<li><span>3</span><div><h3>Copy the token it prints</h3><p>Find <code>Owner access token: ...</code>. Copy everything after the colon. Pasting the complete line also works.</p><div class="token-example"><small>LOOK FOR THIS LINE</small><code>Owner access token: your-private-token</code></div></div></li>
						<li><span>4</span><div><h3>Start CmdImpact and leave it running</h3><div class="setup-code-block compact" data-code-block><div><small>SAME TERMINAL</small><button type="button" data-copy-code aria-label="Copy start command">Copy</button></div><pre><code>npm start</code></pre><span data-copy-status role="status" aria-live="polite"></span></div><p>Wait until Docker finishes starting, then open the local dashboard. Keep this computer and Docker on while sessions run.</p><a class="setup-open-link" href="http://localhost:4321/app/">Open local dashboard <span aria-hidden="true">&rarr;</span></a></div></li>
					</ol>
					<p class="setup-result"><span class="setup-result-icon" aria-hidden="true">&#10003;</span><span><strong>On the local dashboard:</strong> the runner address is automatic. Paste the token and choose <em>Show my sessions</em>.</span></p>
				</section>

				<section id="setup-remote" class="setup-path-panel" data-setup-panel="remote" aria-labelledby="remote-setup-heading" hidden>
					<div class="setup-panel-heading"><span>PRIVATE REMOTE ACCESS</span><div><h2 id="remote-setup-heading">Use it from your phone or another computer</h2><p>Tailscale gives your runner a private HTTPS address without opening router ports.</p></div></div>
					<ol class="guided-steps">
						<li><span>1</span><div><h3>Install Tailscale on both devices</h3><p>Sign in with the same Tailscale account on the runner computer and the phone or computer you will use. <a href="https://tailscale.com/kb/1017/install/" rel="external noopener">Open the official setup guide <span aria-hidden="true">&nearr;</span></a>.</p></div></li>
						<li><span>2</span><div><h3>Set up CmdImpact on the runner computer</h3><div class="setup-code-block" data-code-block><div><small>TERMINAL / POWERSHELL</small><button type="button" data-copy-code aria-label="Copy remote setup commands">Copy</button></div><pre><code>git clone https://github.com/khajaaijaz26/cmdimpact.git
cd cmdimpact
npm run setup -- --origin {remoteDashboardOrigin}</code></pre><span data-copy-status role="status" aria-live="polite"></span></div><p>Copy the <code>Owner access token</code> printed by setup.</p></div></li>
						<li><span>3</span><div><h3>Start CmdImpact</h3><div class="setup-code-block compact" data-code-block><div><small>FIRST TERMINAL</small><button type="button" data-copy-code aria-label="Copy start command">Copy</button></div><pre><code>npm start</code></pre><span data-copy-status role="status" aria-live="polite"></span></div><p>Leave this terminal, Docker, and the runner computer on.</p></div></li>
						<li><span>4</span><div><h3>Create the private runner address</h3><p>Open a second terminal on the runner computer and run:</p><div class="setup-code-block compact" data-code-block><div><small>SECOND TERMINAL</small><button type="button" data-copy-code aria-label="Copy Tailscale Serve command">Copy</button></div><pre><code>tailscale serve --bg 4321</code></pre><span data-copy-status role="status" aria-live="polite"></span></div><p>Approve HTTPS if Tailscale asks. Copy the <code>https://...ts.net</code> address it prints. That is your <strong>runner address</strong>.</p></div></li>
						<li><span>5</span><div><h3>Connect from the other device</h3><p>Keep Tailscale connected, open <a href={`${remoteDashboardOrigin}/app/`}>{remoteDashboardOrigin}/app/</a>, choose <em>I already set it up</em>, then enter the runner address and access token.</p><button class="setup-inline-action" type="button" data-go-setup="connect">Enter runner address and token <span aria-hidden="true">&rarr;</span></button></div></li>
					</ol>
					<p class="setup-result important"><span class="setup-result-icon" aria-hidden="true">!</span><span><strong>The runner computer must stay on.</strong> Your phone or browser can close; active sessions continue on the runner.</span></p>
				</section>

				<section id="setup-connect" class="setup-path-panel login-connect-pane" data-setup-panel="connect" aria-labelledby="connect-setup-heading" hidden>
					<div class="setup-panel-heading"><span>CONNECT NOW</span><div><h2 id="connect-setup-heading">Show my terminal sessions</h2><p>Enter the two values created during setup.</p></div></div>
					<form id="login-form" method="dialog">
						<details id="runner-address-details" class="runner-address-details">
							<summary><span>1</span><span class="runner-address-copy"><strong>Runner address</strong><small id="runner-address-summary">Required</small></span><b aria-hidden="true">Change</b></summary>
							<div><label for="runner-url">Runner address</label><input id="runner-url" name="runner" type="url" inputmode="url" autocomplete="url" spellcheck="false" aria-describedby="runner-help" required /><small id="runner-help" class="form-help">Local: <code>http://localhost:4321</code>. Remote: the <code>https://...ts.net</code> address printed by Tailscale. Do not enter the Vercel dashboard address here.</small></div>
						</details>
						<label for="access-token"><span>2</span> Paste your access token</label>
						<input id="access-token" name="token" type="password" autocomplete="current-password" aria-describedby="token-help" required />
						<small id="token-help" class="form-help">Paste the token or the complete <code>Owner access token: ...</code> line. Both work.</small>
						<p id="login-error" class="form-error" role="alert" hidden></p>
						<button class="app-primary large" type="submit">Show my sessions</button>
					</form>
					<p class="login-security-note">Your owner token is sent directly to your runner once and is not stored by this dashboard.</p>
				</section>
			</div>

			<details class="connection-details">
				<summary><span aria-hidden="true">?</span><strong>How does the connection work?</strong><b aria-hidden="true">+</b></summary>
				<div><div class="app-runner-map" aria-label="The browser connects directly to live sessions on the selected CmdImpact runner"><span><small>THIS BROWSER</small><strong>View + keyboard</strong></span><i><small>Direct secure connection</small><b aria-hidden="true">&harr;</b></i><span><small>YOUR RUNNER</small><strong>Terminal processes</strong></span></div><p class="runner-map-caption">Execution and workspace files stay on your runner. Vercel does not relay or archive terminal traffic.</p><p class="managed-session-note"><span aria-hidden="true">i</span> Only terminals created through CmdImpact appear in Sessions. Existing Terminal or PowerShell windows cannot be imported. The recommended setup uses Docker's isolated <code>/workspace</code>.</p></div>
			</details>
		</div>
	</dialog>

	<dialog id="new-session-dialog" class="app-dialog" aria-labelledby="new-session-heading">
		<form id="new-session-form" method="dialog">
			<div class="dialog-head"><span class="dialog-icon">+</span><button type="button" data-close-dialog aria-label="Close">&times;</button></div>
			<p class="app-kicker">NEW TERMINAL</p>
			<h2 id="new-session-heading">Start a session</h2>
			<p>The shell runs on the connected CmdImpact runner and stays active when the browser disconnects.</p>
			<label for="session-name">Session name</label>
			<input id="session-name" name="name" maxlength="64" placeholder="api migration" autocomplete="off" />
			<label for="session-shell">Shell</label>
			<select id="session-shell" name="shell"></select>
			<p id="session-error" class="form-error" role="alert" hidden></p>
			<div class="dialog-actions"><button type="button" class="dialog-cancel" data-close-dialog>Cancel</button><button class="app-primary" type="submit">Create session</button></div>
		</form>
	</dialog>

	<dialog id="tools-dialog" class="app-dialog tools-dialog" aria-labelledby="tools-heading">
		<div class="dialog-head"><span class="dialog-icon">$_</span><button type="button" data-close-dialog aria-label="Close tools">&times;</button></div>
		<p class="app-kicker">HELP &amp; TOOLS</p>
		<h2 id="tools-heading">Sessions stay on your connected runner.</h2>
		<p>The browser is a view and keyboard. The selected CmdImpact runner owns the real terminal processes.</p>
		<div class="app-runner-map compact" aria-label="The browser connects directly to live sessions on the selected CmdImpact runner">
			<span><small>THIS BROWSER</small><strong>View + keyboard</strong></span>
			<i><small>Direct API + WebSocket</small><b aria-hidden="true">&harr;</b></i>
			<span><small>CONNECTED RUNNER</small><strong>Terminal processes</strong></span>
		</div>
		<ol class="onboarding-steps compact" aria-label="How to use a CmdImpact session">
			<li><span>1</span><div><strong>Create</strong><p>Choose New session, give it a name, and select a shell installed on the runner.</p></div></li>
			<li><span>2</span><div><strong>Run and leave</strong><p>Start your command or AI agent. It can continue without the browser while the runner stays online and the session remains active.</p></div></li>
			<li><span>3</span><div><strong>Resume</strong><p>Connect to the same runner later and choose the session from the sidebar.</p></div></li>
		</ol>
		<ul class="session-status-key" aria-label="Session status meanings">
			<li><i class="attached"></i><span><strong>Attached</strong><small>Open in a browser now</small></span></li>
			<li><i class="running"></i><span><strong>Running / Detached</strong><small>Alive on the runner without this view</small></span></li>
			<li><i class="needs-you"></i><span><strong>Needs you</strong><small>Likely waiting for input</small></span></li>
			<li><i class="finished"></i><span><strong>Finished</strong><small>Stopped and cannot resume</small></span></li>
		</ul>
		<p class="managed-session-note compact"><span aria-hidden="true">i</span> The Sessions sidebar automatically loads CmdImpact-managed sessions from the connected runner.</p>
		<div class="tool-section-heading"><p class="app-kicker">COMMAND SHORTCUTS</p><strong>Optional commands for your terminal</strong></div>
		<p>These are examples, not a whitelist or built-in integration. Insert places text at the prompt but never presses Enter.</p>
		<div class="tool-snippets">
			<article data-command="gh auth login"><div><strong>GitHub CLI</strong><small>Sign in with an installed <code>gh</code> CLI.</small></div><code>gh auth login</code><span><button type="button" data-copy-command aria-label="Copy GitHub CLI command">Copy</button><button type="button" data-insert-command aria-label="Insert GitHub CLI command" disabled>Insert</button></span></article>
			<article data-command="curl -fsSL https://chatgpt.com/codex/install.sh | sh"><div><strong>Codex</strong><small>Official installer; review downloaded scripts before running them.</small></div><code>curl -fsSL https://chatgpt.com/codex/install.sh | sh</code><span><button type="button" data-copy-command aria-label="Copy Codex install command">Copy</button><button type="button" data-insert-command aria-label="Insert Codex install command" disabled>Insert</button></span></article>
			<article data-command="npm install -g @anthropic-ai/claude-code"><div><strong>Claude Code</strong><small>Install the Claude command-line agent.</small></div><code>npm install -g @anthropic-ai/claude-code</code><span><button type="button" data-copy-command aria-label="Copy Claude Code install command">Copy</button><button type="button" data-insert-command aria-label="Insert Claude Code install command" disabled>Insert</button></span></article>
			<article data-command="npm install -g @google/gemini-cli"><div><strong>Gemini CLI</strong><small>Install the Gemini command-line agent.</small></div><code>npm install -g @google/gemini-cli</code><span><button type="button" data-copy-command aria-label="Copy Gemini CLI install command">Copy</button><button type="button" data-insert-command aria-label="Insert Gemini CLI install command" disabled>Insert</button></span></article>
			<article data-command="npm install -g vercel"><div><strong>Vercel CLI</strong><small>Install Vercel's deployment CLI.</small></div><code>npm install -g vercel</code><span><button type="button" data-copy-command aria-label="Copy Vercel CLI install command">Copy</button><button type="button" data-insert-command aria-label="Insert Vercel CLI install command" disabled>Insert</button></span></article>
		</div>
		<section class="notification-preference" aria-labelledby="notification-heading">
			<div><strong id="notification-heading">Browser notifications</strong><small id="notification-copy">Get a generic alert without terminal output when a running session needs you.</small></div>
			<button id="notification-toggle" class="dialog-cancel" type="button">Enable notifications</button>
		</section>
		<p class="tools-limit">Alerts depend on this page staying open and the browser continuing background polling. Suspended tabs and closed pages will not alert; push is not included.</p>
		<a class="tools-setup-link" href="https://github.com/khajaaijaz26/cmdimpact#connect-the-global-dashboard-to-your-runner" rel="external noopener">Read the complete runner setup documentation <span aria-hidden="true">&nearr;</span></a>
		<p id="tools-status" class="form-status" role="status" aria-live="polite"></p>
	</dialog>

	<dialog id="guard-dialog" class="app-dialog guard-dialog" aria-labelledby="guard-heading">
		<div class="dialog-head"><span class="dialog-icon warning">!</span><button type="button" data-guard-action="cancel" aria-label="Close">&times;</button></div>
		<p class="app-kicker">COMMAND GUARD</p>
		<h2 id="guard-heading">Review this paste</h2>
		<p id="guard-summary">Review the complete command before it reaches your shell.</p>
		<section class="guard-preview" aria-labelledby="guard-preview-heading">
			<div><strong id="guard-preview-heading">Full paste</strong><small>Lossless escaped view: backslashes are doubled and controls use <code>\xNN</code>.</small></div>
			<pre id="guard-preview" tabindex="0" aria-label="Full paste with visible control characters"></pre>
		</section>
		<div id="guard-findings" class="guard-findings"></div>
		<p id="guard-findings-omitted" class="guard-omitted" hidden></p>
		<p class="guard-limit">Risk indicators are heuristic only. CmdImpact cannot inspect remote code or prove a command is safe.</p>
		<div class="dialog-actions guard-buttons">
			<button type="button" class="dialog-cancel" data-guard-action="cancel">Cancel</button>
			<button type="button" class="dialog-cancel" data-guard-action="paste">Paste as one line</button>
			<button type="button" class="app-danger" data-guard-action="send">Send anyway</button>
		</div>
	</dialog>

	<dialog id="end-session-dialog" class="app-dialog" aria-labelledby="end-dialog-title">
		<div class="dialog-head"><span class="dialog-icon danger">!</span><button type="button" data-close-dialog aria-label="Close">&times;</button></div>
		<p class="app-kicker">DESTRUCTIVE ACTION</p>
		<h2 id="end-dialog-title">End this session?</h2>
		<p id="end-dialog-copy">The shell and jobs attached to <strong id="end-session-name">this session</strong> will stop. It cannot be resumed.</p>
		<p id="end-error" class="form-error" role="alert" hidden></p>
		<div class="dialog-actions"><button type="button" class="dialog-cancel" data-close-dialog>Keep session</button><button id="confirm-end-session" class="app-danger" type="button">End session</button></div>
	</dialog>
</AppLayout>

<script>
	import { Terminal } from '@xterm/xterm';
	import { FitAddon } from '@xterm/addon-fit';
	import { WebLinksAddon } from '@xterm/addon-web-links';
	import '@xterm/xterm/css/xterm.css';
	import { analyzeCommand, type CommandFinding } from '../../lib/command-check';
	import { pasteAsOneLine, terminalInputFits, visiblePaste } from '../../lib/terminal-paste';
	import { defaultRunnerOrigin, isRunnerHealth, normalizeRunnerOrigin } from '../../lib/runner-url';

	interface SessionRecord {
		id: string;
		name: string;
		shell: string;
		state: 'running' | 'detached' | 'exited';
		createdAt: string;
		lastAttachedAt: string | null;
		detachedAt: string | null;
		exitedAt: string | null;
		exitCode: number | null;
		exitReason: string | null;
		attentionAt: string | null;
		attentionKind: 'bell' | 'approval' | 'input' | null;
		clients: number;
		writable: boolean;
	}

	type SocketMessage = {
		type?: 'hello' | 'ready' | 'output' | 'control' | 'pong' | 'exit' | 'error';
		protocol?: number;
		attachWithinMs?: number;
		session?: SessionRecord;
		writable?: boolean;
		reason?: string;
		data?: string;
		message?: string;
		code?: string;
		exitCode?: number | null;
	};

	const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const loginScreen = element<HTMLDialogElement>('login-screen');
	const loginForm = element<HTMLFormElement>('login-form');
	const loginError = element<HTMLParagraphElement>('login-error');
	const tokenInput = element<HTMLInputElement>('access-token');
	const runnerInput = element<HTMLInputElement>('runner-url');
	const runnerAddressDetails = element<HTMLDetailsElement>('runner-address-details');
	const runnerAddressSummary = element<HTMLElement>('runner-address-summary');
	const setupPathButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-setup-path]'));
	const setupPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-setup-panel]'));
	const runnerButton = element<HTMLButtonElement>('runner-button');
	const runnerOriginLabel = element<HTMLElement>('runner-origin');
	const sidebarRunner = element<HTMLElement>('sidebar-runner');
	const runnerDot = element<HTMLElement>('runner-dot');
	const sessionList = element<HTMLDivElement>('session-list');
	const emptyState = element<HTMLElement>('workspace-empty');
	const activeWorkspace = element<HTMLElement>('active-workspace');
	const activeName = element<HTMLElement>('active-session-name');
	const activeMeta = element<HTMLElement>('active-session-meta');
	const globalConnection = element<HTMLElement>('global-connection');
	const terminalConnection = element<HTMLElement>('terminal-connection');
	const terminalSize = element<HTMLElement>('terminal-size');
	const overlay = element<HTMLElement>('terminal-overlay');
	const overlayTitle = element<HTMLElement>('terminal-overlay-title');
	const overlayDetail = element<HTMLElement>('terminal-overlay-detail');
	const reconnectButton = element<HTMLButtonElement>('reconnect-session');
	const newDialog = element<HTMLDialogElement>('new-session-dialog');
	const newForm = element<HTMLFormElement>('new-session-form');
	const sessionNameInput = element<HTMLInputElement>('session-name');
	const sessionShellInput = element<HTMLSelectElement>('session-shell');
	const sessionError = element<HTMLParagraphElement>('session-error');
	const guardDialog = element<HTMLDialogElement>('guard-dialog');
	const guardSummary = element<HTMLElement>('guard-summary');
	const guardPreview = element<HTMLElement>('guard-preview');
	const guardFindings = element<HTMLElement>('guard-findings');
	const guardFindingsOmitted = element<HTMLElement>('guard-findings-omitted');
	const endDialog = element<HTMLDialogElement>('end-session-dialog');
	const endName = element<HTMLElement>('end-session-name');
	const endTitle = element<HTMLElement>('end-dialog-title');
	const endCopy = element<HTMLElement>('end-dialog-copy');
	const endError = element<HTMLParagraphElement>('end-error');
	const endButton = element<HTMLButtonElement>('confirm-end-session');
	const takeControlButton = element<HTMLButtonElement>('take-control');
	const toolsDialog = element<HTMLDialogElement>('tools-dialog');
	const toolsStatus = element<HTMLParagraphElement>('tools-status');
	const notificationToggle = element<HTMLButtonElement>('notification-toggle');
	const notificationCopy = element<HTMLElement>('notification-copy');
	const sidebar = element<HTMLElement>('session-sidebar');
	const sidebarToggle = element<HTMLButtonElement>('sidebar-toggle');
	const scrim = element<HTMLButtonElement>('sidebar-scrim');
	const mobileSidebar = window.matchMedia('(max-width: 54rem)');
	const RUNNER_ORIGIN_KEY = 'cmdimpact.runnerOrigin';
	const SESSION_AUTH_KEY = 'cmdimpact.sessionAuth';
	const NOTIFICATION_KEY = 'cmdimpact.notificationsEnabled';
	type SetupPath = 'local' | 'remote' | 'connect';

	let sessions: SessionRecord[] = [];
	let selected: SessionRecord | undefined;
	let socket: WebSocket | undefined;
	let reconnectTimer = 0;
	let reconnectAttempts = 0;
	let connectionGeneration = 0;
	let manualDisconnect = false;
	let pendingPaste = '';
	let availableShells: string[] = [];
	let writable = false;
	let heartbeatTimer = 0;
	let runnerOrigin = defaultRunnerOrigin(readStorage(localStorage, RUNNER_ORIGIN_KEY), location.origin);
	let sessionToken = loadSessionToken();
	let runnerGeneration = 0;
	let sessionLoadGeneration = 0;
	let notificationRegistration: Promise<ServiceWorkerRegistration> | undefined;
	let notificationsEnabled = readStorage(localStorage, NOTIFICATION_KEY) === 'true';
	const knownAttention = new Map<string, string>();
	const seenAttention = new Map<string, string>();
	class StaleRunnerRequest extends Error {}

	function readStorage(storage: Storage, key: string) {
		try { return storage.getItem(key); } catch { return null; }
	}

	function writeStorage(storage: Storage, key: string, value?: string) {
		try {
			if (value === undefined) storage.removeItem(key);
			else storage.setItem(key, value);
		} catch { /* Storage may be blocked by the browser. */ }
	}

	function loadSessionToken() {
		try {
			const stored = JSON.parse(readStorage(sessionStorage, SESSION_AUTH_KEY) || 'null');
			return stored?.origin === runnerOrigin && typeof stored?.token === 'string' ? stored.token : '';
		} catch { return ''; }
	}

	function saveSessionToken(token = '') {
		sessionToken = token;
		runnerGeneration += 1;
		writeStorage(sessionStorage, SESSION_AUTH_KEY, token ? JSON.stringify({ origin: runnerOrigin, token }) : undefined);
	}

	function assertCurrentRunner(generation: number) {
		if (generation !== runnerGeneration) throw new StaleRunnerRequest();
	}

	function staleRunnerRequest(error: unknown, generation: number) {
		return error instanceof StaleRunnerRequest || generation !== runnerGeneration;
	}

	function updateRunnerAddressSummary() {
		const address = runnerInput.value.trim();
		runnerAddressSummary.textContent = address || 'Required';
		if (!address) runnerAddressDetails.open = true;
	}

	function selectSetupPath(path: SetupPath) {
		setupPathButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setupPath === path)));
		setupPanels.forEach((panel) => (panel.hidden = panel.dataset.setupPanel !== path));
		if (path === 'connect') updateRunnerAddressSummary();
	}

	const fitAddon = new FitAddon();
	const terminal = new Terminal({
		cursorBlink: true,
		cursorStyle: 'bar',
		fontFamily: '"SFMono-Regular", Consolas, "Liberation Mono", monospace',
		fontSize: 14,
		lineHeight: 1.35,
		scrollback: 5000,
		allowProposedApi: false,
		theme: {
			background: '#151a23',
			foreground: '#e7eaf0',
			cursor: '#90a8e8',
			cursorAccent: '#151a23',
			selectionBackground: '#35466f',
			black: '#151a23',
			red: '#d66d68',
			green: '#72a78e',
			yellow: '#c9a064',
			blue: '#839ce0',
			magenta: '#aa8ebd',
			cyan: '#70a5ab',
			white: '#e7eaf0',
			brightBlack: '#667184',
			brightRed: '#e3837f',
			brightGreen: '#8abb9f',
			brightYellow: '#d8b479',
			brightBlue: '#9db1e9',
			brightMagenta: '#bea5cc',
			brightCyan: '#89b9be',
			brightWhite: '#ffffff',
		},
	});
	terminal.loadAddon(fitAddon);
	terminal.loadAddon(new WebLinksAddon());
	terminal.open(element<HTMLDivElement>('terminal'));

	function sessionLabel(session: SessionRecord) {
		return session.name.trim() || 'Untitled session';
	}

	function validSessionId(value: unknown): value is string {
		return typeof value === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
	}

	function requestedSessionId() {
		const candidate = new URLSearchParams(location.hash.slice(1)).get('session');
		return validSessionId(candidate) ? candidate : '';
	}

	function updateRunnerDisplay() {
		const label = runnerOrigin || 'Choose runner';
		runnerOriginLabel.textContent = label;
		runnerOriginLabel.title = label;
		sidebarRunner.textContent = runnerOrigin ? new URL(runnerOrigin).host : 'CmdImpact runner';
	}

	function runnerState(state: 'idle' | 'connecting' | 'connected' | 'offline' | 'error', label: string) {
		runnerButton.dataset.state = state;
		runnerDot.dataset.state = state;
		element<HTMLElement>('server-status').textContent = label;
		runnerButton.setAttribute('aria-label', 'Change terminal runner. ' + label + (runnerOrigin ? ': ' + runnerOrigin : ''));
	}

	function connectionState(state: 'idle' | 'connecting' | 'connected' | 'offline' | 'error', label: string) {
		globalConnection.dataset.state = state;
		terminalConnection.dataset.state = state;
		const globalLabel = globalConnection.querySelector('span');
		if (globalLabel) globalLabel.textContent = label;
		terminalConnection.lastChild!.textContent = label;
		reconnectButton.hidden = state !== 'offline' && state !== 'error';
	}

	async function api(path: string, options: RequestInit = {}, generation = runnerGeneration) {
		assertCurrentRunner(generation);
		const origin = runnerOrigin;
		const token = sessionToken;
		if (!origin) throw new Error('Choose a valid runner URL first.');
		const headers = new Headers(options.headers);
		if (options.body) headers.set('Content-Type', 'application/json');
		if (token) headers.set('Authorization', 'Bearer ' + token);
		let response: Response;
		try {
			response = await fetch(origin + path, {
				...options,
				headers,
				credentials: origin === location.origin ? 'include' : 'omit',
			});
		} catch (error) {
			assertCurrentRunner(generation);
			throw error;
		}
		assertCurrentRunner(generation);
		if (response.status === 401 && path !== '/api/auth/login' && path !== '/api/me') {
			const hadWorkspace = Boolean(selected || sessions.length);
			handleUnauthorized(hadWorkspace ? 'Your sign-in expired. Enter the access token again.' : '');
			throw new StaleRunnerRequest();
		}
		return response;
	}

	async function responseJson(response: Response, generation: number) {
		try {
			const body = await response.json();
			assertCurrentRunner(generation);
			return body;
		} catch (error) {
			assertCurrentRunner(generation);
			throw error;
		}
	}

	async function responseJsonOr(response: Response, generation: number, fallback: unknown) {
		try {
			return await responseJson(response, generation);
		} catch (error) {
			assertCurrentRunner(generation);
			return fallback;
		}
	}

	function normalizeSessions(value: unknown): SessionRecord[] {
		const records = Array.isArray(value) ? value : typeof value === 'object' && value !== null && Array.isArray((value as { sessions?: unknown[] }).sessions)
			? (value as { sessions: unknown[] }).sessions
			: [];
		return records.filter((item): item is SessionRecord => {
			return typeof item === 'object' && item !== null && typeof (item as SessionRecord).id === 'string';
		});
	}

	function groupFor(session: SessionRecord) {
		if (session.state === 'exited') return 'Finished';
		if (needsAttention(session)) return 'Needs you';
		if (session.state === 'detached') return 'Detached';
		return session.clients > 0 ? 'Attached' : 'Running';
	}

	function formatAge(value?: string) {
		if (!value) return '';
		const timestamp = Date.parse(value);
		if (!Number.isFinite(timestamp)) return '';
		const seconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
		if (seconds < 60) return 'now';
		if (seconds < 3600) return Math.floor(seconds / 60) + 'm';
		if (seconds < 86400) return Math.floor(seconds / 3600) + 'h';
		return Math.floor(seconds / 86400) + 'd';
	}

	function needsAttention(session: SessionRecord) {
		if (!session.attentionAt || !Number.isFinite(Date.parse(session.attentionAt))) return false;
		const seen = seenAttention.get(session.id);
		return !seen || Date.parse(session.attentionAt) > Date.parse(seen);
	}

	function notificationsSupported() {
		return 'Notification' in window && 'serviceWorker' in navigator;
	}

	async function notificationServiceWorker() {
		if (!notificationsSupported()) throw new Error('Browser notifications are not supported.');
		notificationRegistration ??= navigator.serviceWorker.register('/app/sw.js', { scope: '/app/' }).then(() => navigator.serviceWorker.ready);
		try {
			return await notificationRegistration;
		} catch (error) {
			notificationRegistration = undefined;
			throw error;
		}
	}

	async function notifyAttention(session: SessionRecord) {
		if (!document.hidden || !notificationsEnabled || !notificationsSupported() || Notification.permission !== 'granted') return;
		const generation = runnerGeneration;
		try {
			const registration = await notificationServiceWorker();
			if (!document.hidden || !notificationsEnabled || generation !== runnerGeneration || Notification.permission !== 'granted') return;
			await registration.showNotification('CmdImpact session needs you', {
				body: 'Open the browser terminal to continue.',
				tag: 'cmdimpact-attention-' + session.id,
				data: { sessionId: session.id },
			});
		} catch { /* Permission or service-worker availability may change while hidden. */ }
	}

	function processAttention(nextSessions: SessionRecord[]) {
		nextSessions.forEach((session) => {
			const next = session.attentionAt || '';
			const tracked = knownAttention.has(session.id);
			const previous = knownAttention.get(session.id) || '';
			if (tracked && next && next !== previous) void notifyAttention(session);
			knownAttention.set(session.id, next);
			if (!next) seenAttention.delete(session.id);
		});
	}

	function renderNotificationPreference() {
		if (!notificationsSupported()) {
			notificationsEnabled = false;
			notificationToggle.disabled = true;
			notificationToggle.textContent = 'Not supported';
			notificationCopy.textContent = 'This browser does not support service-worker notifications.';
			return;
		}
		if (Notification.permission === 'denied') {
			notificationsEnabled = false;
			writeStorage(localStorage, NOTIFICATION_KEY, 'false');
			notificationToggle.disabled = true;
			notificationToggle.textContent = 'Blocked in browser';
			notificationCopy.textContent = 'Allow notifications in browser settings to enable session alerts.';
			return;
		}
		if (Notification.permission !== 'granted') notificationsEnabled = false;
		notificationToggle.disabled = false;
		notificationToggle.textContent = notificationsEnabled ? 'Disable notifications' : 'Enable notifications';
		notificationToggle.setAttribute('aria-pressed', String(notificationsEnabled));
		notificationCopy.textContent = notificationsEnabled
			? 'Generic alerts are enabled while this open page continues polling.'
			: 'Get a generic alert without terminal output when a running session needs you.';
	}

	function markAttentionSeen(session: SessionRecord) {
		if (session.attentionAt) seenAttention.set(session.id, session.attentionAt);
	}

	function renderSessions() {
		sessionList.replaceChildren();
		if (!sessions.length) {
			const empty = document.createElement('div');
			empty.className = 'sidebar-empty';
			const strong = document.createElement('strong');
			strong.textContent = 'No CmdImpact sessions';
			const span = document.createElement('span');
			span.textContent = 'Create one to run it on the selected runner.';
			empty.append(strong, span);
			sessionList.append(empty);
			return;
		}

		['Needs you', 'Attached', 'Running', 'Detached', 'Finished'].forEach((group) => {
			const matching = sessions.filter((session) => groupFor(session) === group);
			if (!matching.length) return;
			const heading = document.createElement('p');
			heading.className = 'session-list-heading';
			heading.textContent = group.toUpperCase();
			sessionList.append(heading);
			matching.forEach((session) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'session-item' + (selected?.id === session.id ? ' is-current' : '');
				button.dataset.status = group.toLowerCase().replace(' ', '-');
				if (selected?.id === session.id) button.setAttribute('aria-current', 'true');
				const status = document.createElement('i');
				status.setAttribute('aria-hidden', 'true');
				const copy = document.createElement('span');
				const title = document.createElement('strong');
				title.textContent = sessionLabel(session);
				const meta = document.createElement('small');
				meta.textContent = session.shell + ' / ' + (needsAttention(session) ? 'needs attention' : session.state);
				const age = document.createElement('time');
				age.textContent = formatAge(session.exitedAt || session.detachedAt || session.lastAttachedAt || session.createdAt);
				copy.append(title, meta);
				button.append(status, copy, age);
				button.addEventListener('click', () => selectSession(session));
				sessionList.append(button);
			});
		});
	}

	async function loadSessions(expectedConnectionGeneration?: number, generation = runnerGeneration) {
		const loadGeneration = ++sessionLoadGeneration;
		try {
			const response = await api('/api/sessions', {}, generation);
			if (loadGeneration !== sessionLoadGeneration || (expectedConnectionGeneration !== undefined && expectedConnectionGeneration !== connectionGeneration)) return false;
			if (!response.ok) throw new Error('Could not load sessions.');
			const body = await responseJson(response, generation);
			if (loadGeneration !== sessionLoadGeneration || (expectedConnectionGeneration !== undefined && expectedConnectionGeneration !== connectionGeneration)) return false;
			const nextSessions = normalizeSessions(body);
			processAttention(nextSessions);
			sessions = nextSessions;
			if (Array.isArray(body.shells)) {
				availableShells = body.shells.filter((shell: unknown): shell is string => typeof shell === 'string');
				renderShellOptions();
			}
			runnerState('connected', 'Online');
			renderSessions();
			if (selected) {
				selected = sessions.find((item) => item.id === selected?.id);
				if (!selected) {
					showEmpty();
				} else {
					activeName.textContent = sessionLabel(selected);
					activeMeta.textContent = selected.shell + ' / ' + selected.state + (writable ? ' / keyboard control' : ' / view only');
					element<HTMLButtonElement>('end-session').textContent = selected.state === 'exited' ? 'Remove' : 'End';
				}
			}
			return true;
		} catch (error) {
			if (staleRunnerRequest(error, generation)) return false;
			throw error;
		}
	}

	function showLogin(message = '', path: SetupPath = runnerOrigin ? 'connect' : 'local') {
		updateRunnerDisplay();
		if (!runnerInput.value) runnerInput.value = runnerOrigin;
		selectSetupPath(path);
		updateRunnerAddressSummary();
		if (!loginScreen.open) loginScreen.showModal();
		loginError.hidden = !message;
		loginError.textContent = message;
		window.setTimeout(() => {
			if (path === 'connect') (runnerInput.value ? tokenInput : runnerInput).focus();
			else setupPathButtons.find((button) => button.dataset.setupPath === path)?.focus();
		}, 0);
	}

	function hideLogin() {
		if (loginScreen.open) loginScreen.close();
		tokenInput.value = '';
		loginError.hidden = true;
	}

	function renderShellOptions() {
		sessionShellInput.replaceChildren();
		const shells = availableShells.length ? availableShells : ['default'];
		shells.forEach((shell) => {
			const option = document.createElement('option');
			option.value = shell === 'default' ? '' : shell;
			option.textContent = shell === 'default' ? 'Runner default' : shell;
			sessionShellInput.append(option);
		});
	}

	async function bootstrap() {
		updateRunnerDisplay();
		if (!runnerOrigin) {
			runnerState('idle', 'Not configured');
			showLogin('', 'local');
			return;
		}
		const generation = runnerGeneration;
		runnerState('connecting', 'Checking connection...');
		try {
			const response = await api('/api/me', {}, generation);
			if (!response.ok) {
				runnerState('error', response.status === 404 ? 'No runner at this address' : 'Runner error');
				showLogin(response.status === 404 ? 'No runner was found at this address. Check the runner address and try again.' : 'The runner could not verify this browser. Check its address and try again.', 'connect');
				return;
			}
			const identity = await responseJsonOr(response, generation, null);
			if (!identity || typeof identity.authenticated !== 'boolean') {
				runnerState('error', 'Invalid runner response');
				showLogin('This address does not appear to be a CmdImpact runner. Enter the HTTPS address created during setup.', 'connect');
				return;
			}
			if (identity.authenticated === false) {
				runnerState('connected', 'Sign in required');
				showLogin('', 'connect');
				return;
			}
			if (Array.isArray(identity.shells)) {
				availableShells = identity.shells.filter((shell: unknown): shell is string => typeof shell === 'string');
				renderShellOptions();
			}
			hideLogin();
			if (!await loadSessions(undefined, generation)) return;
			runnerState('connected', 'Online');
			const requested = requestedSessionId();
			const first = sessions.find((item) => item.id === requested) || sessions.find((item) => item.state !== 'exited');
			if (first) selectSession(first);
		} catch (error) {
			if (staleRunnerRequest(error, generation)) return;
			runnerState('offline', 'Unavailable');
			showLogin('The selected CmdImpact runner is unavailable. Check its address and try again.', 'connect');
		}
	}

	loginForm.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submit = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (submit) submit.disabled = true;
		loginError.hidden = true;
		let generation = runnerGeneration;
		try {
			const nextOrigin = normalizeRunnerOrigin(runnerInput.value);
			const submittedToken = tokenInput.value.trim().replace(/^owner access token:\s*/i, '');
			if (nextOrigin !== runnerOrigin) disconnectSocket();
			runnerOrigin = nextOrigin;
			saveSessionToken();
			generation = runnerGeneration;
			updateRunnerDisplay();
			runnerState('connecting', 'Checking runner...');
			const probe = await api('/api/health', {}, generation);
			const health = probe.ok ? await responseJsonOr(probe, generation, null) : null;
			if (!probe.ok || !isRunnerHealth(health)) {
				writeStorage(localStorage, RUNNER_ORIGIN_KEY);
				runnerOrigin = '';
				runnerInput.value = '';
				tokenInput.value = '';
				saveSessionToken();
				updateRunnerDisplay();
				runnerState('error', 'Invalid runner');
				showLogin('This address does not appear to be a CmdImpact runner. Check the runner address and try again.', 'connect');
				return;
			}
			writeStorage(localStorage, RUNNER_ORIGIN_KEY, runnerOrigin);
			runnerState('connecting', 'Signing in...');
			const response = await api('/api/auth/login', {
				method: 'POST',
				body: JSON.stringify({ token: submittedToken }),
			}, generation);
			const body = await responseJsonOr(response, generation, {});
			if (!response.ok) {
				runnerState('error', 'Sign-in failed');
				throw new Error(body.error || 'That access token was not accepted.');
			}
			const nextToken = typeof body.sessionToken === 'string' && body.sessionToken.length <= 4096 ? body.sessionToken : '';
			saveSessionToken(nextToken);
			generation = runnerGeneration;
			hideLogin();
			if (!await loadSessions(undefined, generation)) return;
			runnerState('connected', 'Online');
			const requested = requestedSessionId();
			const first = sessions.find((item) => item.id === requested) || sessions.find((item) => item.state !== 'exited');
			if (first) selectSession(first);
		} catch (error) {
			if (staleRunnerRequest(error, generation)) return;
			if (runnerButton.dataset.state === 'connecting') runnerState('offline', 'Unavailable');
			showLogin(error instanceof Error ? error.message : 'Sign-in failed.', 'connect');
		} finally {
			if (submit) submit.disabled = false;
		}
	});

	element<HTMLButtonElement>('logout-button').addEventListener('click', async () => {
		const generation = runnerGeneration;
		let response: Response;
		try {
			response = await api('/api/auth/logout', { method: 'POST' }, generation);
		} catch (error) {
			if (staleRunnerRequest(error, generation)) return;
			window.alert('Sign-out was not confirmed. You are still signed in; check the connection and try again.');
			return;
		}
		if (!response.ok) {
			window.alert('Sign-out was not confirmed. You are still signed in; check the connection and try again.');
			return;
		}
		handleUnauthorized();
	});

	runnerButton.addEventListener('click', () => {
		selected = undefined;
		sessions = [];
		availableShells = [];
		knownAttention.clear();
		seenAttention.clear();
		saveSessionToken();
		tokenInput.value = '';
		renderSessions();
		showEmpty();
		runnerState('idle', 'Choose a runner');
		showLogin('', 'connect');
		runnerAddressDetails.open = true;
		window.setTimeout(() => {
			runnerInput.focus();
			runnerInput.select();
		}, 0);
	});

	function socketUrl() {
		const url = new URL(runnerOrigin);
		url.protocol = url.protocol === 'https:' ? 'wss:' : 'ws:';
		url.pathname = '/ws';
		return url.href;
	}

	function send(message: object) {
		if (socket?.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message));
	}

	function sendInput(data: string) {
		if (!terminalInputFits(data)) {
			terminal.writeln('\r\n\x1b[38;2;214;109;104m[input not sent] Paste a smaller section; one terminal message is limited to 32 KiB.\x1b[0m');
			return;
		}
		send({ type: 'input', data });
	}

	function updateToolActions() {
		const canInsert = Boolean(writable && selected && selected.state !== 'exited' && socket?.readyState === WebSocket.OPEN);
		document.querySelectorAll<HTMLButtonElement>('[data-insert-command]').forEach((button) => { button.disabled = !canInsert; });
	}

	function setWritable(next: boolean, reason = '') {
		writable = next;
		terminal.options.disableStdin = !next;
		takeControlButton.hidden = next || !selected || selected.state === 'exited';
		if (selected) {
			selected.writable = next;
			activeMeta.textContent = selected.shell + ' / ' + selected.state + (next ? ' / keyboard control' : ' / view only');
		}
		updateToolActions();
		if (reason && !next) terminal.writeln('\r\n\x1b[38;2;201;160;100m[view only] ' + reason + '\x1b[0m');
	}

	function writeSocketMessage(event: MessageEvent) {
		if (typeof event.data !== 'string') return;
		let message: SocketMessage;
		try {
			message = JSON.parse(event.data) as SocketMessage;
		} catch {
			terminal.writeln('\r\n\x1b[38;2;214;109;104m[invalid runner frame]\x1b[0m');
			return;
		}
		if (message.type === 'hello') {
			if (!selected) return;
			send({ type: 'attach', sessionId: selected.id, takeover: false });
		} else if (message.type === 'ready') {
			const readySession = message.session;
			if (readySession && selected?.id === readySession.id) {
				sessionLoadGeneration += 1;
				selected = readySession;
				sessions = sessions.map((item) => item.id === readySession.id ? readySession : item);
			}
			reconnectAttempts = 0;
			overlay.hidden = true;
			connectionState('connected', message.writable ? 'Connected' : 'View only');
			setWritable(Boolean(message.writable));
			renderSessions();
			try { fitAddon.fit(); } catch { /* terminal may still be settling */ }
			if (message.writable) send({ type: 'resize', cols: terminal.cols, rows: terminal.rows });
			if (message.writable) terminal.focus();
			window.clearInterval(heartbeatTimer);
			heartbeatTimer = window.setInterval(() => send({ type: 'ping', nonce: String(Date.now()) }), 25000);
		} else if (message.type === 'output') {
			terminal.write(message.data || '');
		} else if (message.type === 'control') {
			connectionState('connected', message.writable ? 'Connected' : 'View only');
			setWritable(Boolean(message.writable), message.reason || '');
		} else if (message.type === 'exit') {
			terminal.writeln('\r\n\x1b[38;2;146;155;171m[session ended' + (typeof message.exitCode === 'number' ? ' with code ' + message.exitCode : '') + ']\x1b[0m');
			connectionState('offline', 'Session ended');
			manualDisconnect = true;
			if (selected) {
				sessionLoadGeneration += 1;
				selected.state = 'exited';
				selected.exitCode = message.exitCode ?? null;
				selected.exitReason = message.reason || null;
				activeMeta.textContent = selected.shell + ' / exited';
				element<HTMLButtonElement>('end-session').textContent = 'Remove';
				setWritable(false);
				renderSessions();
			}
		} else if (message.type === 'error') {
			terminal.writeln('\r\n\x1b[38;2;214;109;104m[error] ' + (message.message || message.data || 'Terminal error') + '\x1b[0m');
		}
		return message;
	}

	function scheduleReconnect(generation: number) {
		if (manualDisconnect || !selected || generation !== connectionGeneration) return;
		reconnectAttempts += 1;
		const delay = Math.min(8000, 500 * Math.pow(2, reconnectAttempts - 1));
		connectionState('offline', 'Reconnecting...');
		window.clearTimeout(reconnectTimer);
		reconnectTimer = window.setTimeout(() => {
			if (selected && generation === connectionGeneration) connectSocket(selected);
		}, delay);
	}

	function disconnectSocket() {
		manualDisconnect = true;
		connectionGeneration += 1;
		window.clearTimeout(reconnectTimer);
		window.clearInterval(heartbeatTimer);
		send({ type: 'detach' });
		socket?.close();
		socket = undefined;
		setWritable(false);
	}

	function connectSocket(session: SessionRecord) {
		disconnectSocket();
		const generation = connectionGeneration;
		manualDisconnect = false;
		terminal.reset();
		terminal.writeln('\x1b[38;2;146;155;171mConnecting to ' + sessionLabel(session) + '...\x1b[0m');
		overlay.hidden = false;
		overlayTitle.textContent = reconnectAttempts ? 'Reconnecting...' : 'Connecting...';
		overlayDetail.textContent = 'The shell process remains on this runner.';
		connectionState('connecting', 'Connecting');
		setWritable(false);
		let nextSocket: WebSocket;
		try {
			nextSocket = sessionToken
				? new WebSocket(socketUrl(), 'cmdimpact.auth.' + sessionToken)
				: new WebSocket(socketUrl());
		} catch {
			manualDisconnect = true;
			overlayTitle.textContent = 'Connection refused';
			overlayDetail.textContent = 'The runner returned an invalid browser session. Sign in again.';
			connectionState('error', 'Sign-in error');
			saveSessionToken();
			showLogin('The runner returned an invalid browser session. Enter the access token again.', 'connect');
			return;
		}
		let serverErrorCode = '';
		socket = nextSocket;
		nextSocket.addEventListener('open', () => {
			if (generation !== connectionGeneration) return;
			connectionState('connecting', 'Authorizing');
		});
		nextSocket.addEventListener('message', (event) => {
			if (generation !== connectionGeneration) return;
			const message = writeSocketMessage(event);
			if (message?.type === 'error') serverErrorCode = message.code || '';
		});
		nextSocket.addEventListener('error', () => {
			if (generation === connectionGeneration) connectionState('error', 'Connection error');
		});
		nextSocket.addEventListener('close', async (event) => {
			if (generation !== connectionGeneration) return;
			const failedSessionId = session.id;
			window.clearInterval(heartbeatTimer);
			setWritable(false);
			if (event.code === 1008) {
				manualDisconnect = true;
				overlay.hidden = false;
				overlayTitle.textContent = 'Connection refused';
				overlayDetail.textContent = 'Checking your sign-in and runner origin settings...';
				const runnerRequestGeneration = runnerGeneration;
				try {
					const response = await api('/api/me', {}, runnerRequestGeneration);
					if (generation !== connectionGeneration || runnerRequestGeneration !== runnerGeneration) return;
					const identity = response.ok ? await responseJsonOr(response, runnerRequestGeneration, { authenticated: false }) : { authenticated: false };
					if (generation !== connectionGeneration || runnerRequestGeneration !== runnerGeneration) return;
					if (!identity.authenticated) {
						showLogin('Your sign-in expired. Enter the access token again.', 'connect');
					} else if (serverErrorCode === 'not-live') {
						if (!await loadSessions(generation, runnerRequestGeneration)) return;
						const ended = sessions.find((session) => session.id === failedSessionId);
						if (ended?.state === 'exited') selectSession(ended);
						else if (selected?.id === failedSessionId) showEmpty();
					} else {
						overlayDetail.textContent = 'The runner rejected this terminal attachment. Refresh or check the runner settings.';
						connectionState('error', 'Attachment refused');
					}
				} catch (error) {
					if (generation !== connectionGeneration || staleRunnerRequest(error, runnerRequestGeneration)) return;
					showLogin('The CmdImpact runner is unavailable. Confirm it is running and refresh this page.', 'connect');
				}
				return;
			}
			overlay.hidden = false;
			overlayTitle.textContent = manualDisconnect ? 'Disconnected' : 'Connection lost';
			overlayDetail.textContent = manualDisconnect ? 'Reconnect when you are ready.' : 'The process may still be running. Trying again...';
			scheduleReconnect(generation);
		});
	}

	function selectSession(session: SessionRecord) {
		disconnectSocket();
		const generation = connectionGeneration;
		selected = session;
		markAttentionSeen(session);
		writable = false;
		emptyState.hidden = true;
		activeWorkspace.hidden = false;
		activeName.textContent = sessionLabel(session);
		activeMeta.textContent = session.shell + ' / ' + session.state;
		element<HTMLButtonElement>('end-session').textContent = session.state === 'exited' ? 'Remove' : 'End';
		renderSessions();
		closeSidebar();
		history.replaceState(null, '', '/app/#session=' + encodeURIComponent(session.id));
		requestAnimationFrame(() => {
			if (generation !== connectionGeneration || selected?.id !== session.id) return;
			fitAddon.fit();
			if (session.state === 'exited') {
				terminal.reset();
				terminal.writeln('\x1b[38;2;146;155;171mThis session has ended' + (typeof session.exitCode === 'number' ? ' with code ' + session.exitCode : '') + '.\x1b[0m');
				if (session.exitReason) terminal.writeln('\x1b[38;2;113;125;143mReason: ' + session.exitReason + '\x1b[0m');
				overlay.hidden = true;
				connectionState('offline', 'Session ended');
				setWritable(false);
			} else {
				connectSocket(session);
			}
		});
	}

	function showEmpty() {
		disconnectSocket();
		emptyState.hidden = false;
		activeWorkspace.hidden = true;
		connectionState('idle', 'Not connected');
		history.replaceState(null, '', '/app/');
	}

	async function openNotifiedSession(sessionId: unknown) {
		if (!validSessionId(sessionId)) return;
		if (loginScreen.open) {
			history.replaceState(null, '', '/app/#session=' + encodeURIComponent(sessionId));
			return;
		}
		const generation = runnerGeneration;
		let requested = sessions.find((session) => session.id === sessionId);
		if (!requested) {
			if (!await loadSessions(undefined, generation)) return;
			requested = sessions.find((session) => session.id === sessionId);
		}
		if (requested && generation === runnerGeneration && selected?.id !== requested.id) selectSession(requested);
	}

	if ('serviceWorker' in navigator) {
		navigator.serviceWorker.addEventListener('message', (event) => {
			if (event.data?.type === 'cmdimpact:open-session') void openNotifiedSession(event.data.sessionId);
		});
	}

	function handleUnauthorized(message = '') {
		saveSessionToken();
		runnerState('connected', 'Sign in required');
		sessions = [];
		selected = undefined;
		renderSessions();
		showEmpty();
		showLogin(message, 'connect');
	}

	terminal.onData((data) => {
		if (writable) sendInput(data);
	});
	terminal.onResize(({ cols, rows }) => {
		terminalSize.textContent = cols + ' x ' + rows;
		if (writable) send({ type: 'resize', cols, rows });
	});
	new ResizeObserver(() => {
		if (!activeWorkspace.hidden) {
			try { fitAddon.fit(); } catch { /* layout is still settling */ }
		}
	}).observe(element<HTMLElement>('terminal'));

	element<HTMLElement>('terminal').addEventListener('paste', (event) => {
		if (!writable) {
			event.preventDefault();
			return;
		}
		const clipboardEvent = event as ClipboardEvent;
		const text = clipboardEvent.clipboardData?.getData('text/plain') || '';
		if (!text) return;
		const report = analyzeCommand(text);
		const hasLineBreaks = /[\r\n]/.test(text);
		event.preventDefault();
		event.stopPropagation();
		pendingPaste = text;
		guardPreview.textContent = visiblePaste(text);
		guardFindings.replaceChildren();
		const omittedFindings = Math.max(0, report.findings.length - 6);
		guardFindingsOmitted.hidden = omittedFindings === 0;
		guardFindingsOmitted.textContent = omittedFindings
			? omittedFindings + ' additional risk indicator' + (omittedFindings === 1 ? ' is' : 's are') + ' omitted from this summary. Review the full paste above.'
			: '';
		guardSummary.textContent = report.findings.length
			? 'CmdImpact found ' + report.findings.length + ' risk indicator' + (report.findings.length === 1 ? '' : 's') + '. Review the complete paste before sending it.' + (hasLineBreaks ? ' It also contains line breaks that may submit more than one command.' : '')
			: 'No known risk indicator matched. This is not proof the command is safe.' + (hasLineBreaks ? ' The paste also contains line breaks that may submit more than one command.' : '');
		if (!report.findings.length) {
			const item = document.createElement('article');
			const icon = document.createElement('span');
			icon.textContent = '!';
			const copy = document.createElement('div');
			const heading = document.createElement('strong');
			heading.textContent = hasLineBreaks ? 'Multiple commands may run' : 'No known indicator matched';
			const detail = document.createElement('p');
			detail.textContent = hasLineBreaks
				? 'Line breaks can submit earlier lines before you have reviewed the rest.'
				: 'Review this command yourself. The checker cannot prove that it is safe.';
			const evidence = document.createElement('code');
			const lines = text.split(/\r\n|\r|\n/).filter((line) => line.length > 0).length;
			evidence.textContent = hasLineBreaks ? String(Math.max(1, lines)) + ' non-empty lines' : '1 command to review';
			copy.append(heading, detail, evidence);
			item.append(icon, copy);
			guardFindings.append(item);
		}
		report.findings.slice(0, 6).forEach((finding: CommandFinding) => {
			const item = document.createElement('article');
			const icon = document.createElement('span');
			icon.textContent = finding.severity === 'high' ? '!' : '?';
			const copy = document.createElement('div');
			const heading = document.createElement('strong');
			heading.textContent = finding.title;
			const detail = document.createElement('p');
			detail.textContent = finding.detail;
			const evidence = document.createElement('code');
			evidence.textContent = finding.evidence;
			copy.append(heading, detail, evidence);
			item.append(icon, copy);
			guardFindings.append(item);
		});
		guardDialog.showModal();
	}, true);

	document.querySelectorAll<HTMLButtonElement>('[data-guard-action]').forEach((button) => {
		button.addEventListener('click', () => {
			const action = button.dataset.guardAction;
			if (action === 'paste') sendInput(pasteAsOneLine(pendingPaste));
			if (action === 'send') sendInput(pendingPaste);
			pendingPaste = '';
			guardDialog.close();
			terminal.focus();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-open-tools]').forEach((button) => {
		button.addEventListener('click', () => {
			toolsStatus.textContent = '';
			updateToolActions();
			renderNotificationPreference();
			toolsDialog.showModal();
		});
	});

	setupPathButtons.forEach((button) => {
		button.addEventListener('click', () => selectSetupPath(button.dataset.setupPath as SetupPath));
	});

	document.querySelectorAll<HTMLButtonElement>('[data-go-setup]').forEach((button) => {
		button.addEventListener('click', () => {
			selectSetupPath(button.dataset.goSetup as SetupPath);
			window.setTimeout(() => (runnerInput.value ? tokenInput : runnerInput).focus(), 0);
		});
	});

	runnerInput.addEventListener('input', updateRunnerAddressSummary);

	document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
		button.addEventListener('click', async () => {
			const block = button.closest<HTMLElement>('[data-code-block]');
			const command = block?.querySelector('code')?.textContent?.trim() || '';
			const status = block?.querySelector<HTMLElement>('[data-copy-status]');
			if (!command || !status) return;
			try {
				await navigator.clipboard.writeText(command);
				status.textContent = 'Copied';
			} catch {
				status.textContent = 'Select the commands and copy them manually.';
			}
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-copy-command], [data-insert-command]').forEach((button) => {
		button.addEventListener('click', async () => {
			const command = button.closest<HTMLElement>('[data-command]')?.dataset.command || '';
			if (!command) return;
			if (button.hasAttribute('data-copy-command')) {
				try {
					await navigator.clipboard.writeText(command);
					toolsStatus.textContent = 'Command copied. Review it before running it.';
				} catch {
					toolsStatus.textContent = 'Clipboard access was blocked. Select and copy the command manually.';
				}
				return;
			}
			if (!writable || !selected || selected.state === 'exited' || socket?.readyState !== WebSocket.OPEN) {
				toolsStatus.textContent = 'Connect to a live session with keyboard control before inserting a command.';
				updateToolActions();
				return;
			}
			sendInput(command);
			toolsDialog.close();
			terminal.focus();
		});
	});

	notificationToggle.addEventListener('click', async () => {
		if (!notificationsSupported()) return;
		toolsStatus.textContent = '';
		if (notificationsEnabled) {
			notificationsEnabled = false;
			writeStorage(localStorage, NOTIFICATION_KEY, 'false');
			toolsStatus.textContent = 'Browser notifications disabled.';
			renderNotificationPreference();
			return;
		}
		try {
			const permission = Notification.permission === 'default' ? await Notification.requestPermission() : Notification.permission;
			if (permission === 'granted') await notificationServiceWorker();
			notificationsEnabled = permission === 'granted';
			writeStorage(localStorage, NOTIFICATION_KEY, String(notificationsEnabled));
			toolsStatus.textContent = notificationsEnabled
				? 'Notifications enabled while this page stays open and continues polling.'
				: 'Notifications were not enabled. You can change permission in browser settings.';
		} catch {
			notificationsEnabled = false;
			writeStorage(localStorage, NOTIFICATION_KEY, 'false');
			toolsStatus.textContent = 'The browser could not enable notifications.';
		}
		renderNotificationPreference();
	});

	const shortcuts: Record<string, string> = {
		escape: '\x1b',
		'control-c': '\x03',
		tab: '\t',
		up: '\x1b[A',
		down: '\x1b[B',
		left: '\x1b[D',
		right: '\x1b[C',
	};
	document.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((button) => {
		button.addEventListener('click', () => {
			if (writable) sendInput(shortcuts[button.dataset.key || ''] || '');
			terminal.focus();
		});
	});

	function openNewDialog() {
		sessionNameInput.value = '';
		sessionError.hidden = true;
		newDialog.showModal();
		window.setTimeout(() => sessionNameInput.focus(), 0);
	}
	['new-session-top', 'new-session-side', 'new-session-empty'].forEach((id) => {
		element<HTMLButtonElement>(id).addEventListener('click', openNewDialog);
	});

	newForm.addEventListener('submit', async (event) => {
		event.preventDefault();
		sessionError.hidden = true;
		const submit = newForm.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (submit) submit.disabled = true;
		const generation = runnerGeneration;
		try {
			const response = await api('/api/sessions', {
				method: 'POST',
				body: JSON.stringify({
					name: sessionNameInput.value.trim() || 'New session',
					shell: sessionShellInput.value || undefined,
					cols: terminal.cols,
					rows: terminal.rows,
				}),
			}, generation);
			if (!response.ok) {
				const body = await responseJsonOr(response, generation, {});
				throw new Error(body.error || 'Could not create the session.');
			}
			const body = await responseJson(response, generation);
			const created = (body.session || body) as SessionRecord;
			if (!created.id) throw new Error('The runner returned an invalid session.');
			sessionLoadGeneration += 1;
			sessions.unshift(created);
			newDialog.close();
			renderSessions();
			selectSession(created);
		} catch (error) {
			if (staleRunnerRequest(error, generation)) return;
			sessionError.textContent = error instanceof Error ? error.message : 'Could not create the session.';
			sessionError.hidden = false;
		} finally {
			if (submit) submit.disabled = false;
		}
	});

	element<HTMLButtonElement>('rename-session').addEventListener('click', async () => {
		if (!selected) return;
		const renaming = selected;
		const name = window.prompt('Rename this session', sessionLabel(renaming))?.trim();
		if (!name || name === sessionLabel(renaming)) return;
		if (name.length > 64) {
			window.alert('Session names can be at most 64 characters.');
			return;
		}
		const generation = runnerGeneration;
		let response: Response;
		try {
			response = await api('/api/sessions/' + encodeURIComponent(renaming.id), {
				method: 'PATCH',
				body: JSON.stringify({ name }),
			}, generation);
		} catch (error) {
			if (staleRunnerRequest(error, generation) || selected?.id !== renaming.id) return;
			window.alert('Could not reach the CmdImpact runner. Try again.');
			return;
		}
		if (generation !== runnerGeneration || selected?.id !== renaming.id) return;
		if (!response.ok) {
			const body = await responseJsonOr(response, generation, {});
			if (selected?.id !== renaming.id) return;
			const message = typeof body.error === 'string' ? body.error : body.error?.message;
			window.alert(message || 'CmdImpact could not rename this session.');
			return;
		}
		sessionLoadGeneration += 1;
		selected.name = name;
		activeName.textContent = name;
		renderSessions();
	});

	element<HTMLButtonElement>('end-session').addEventListener('click', () => {
		if (!selected) return;
		endName.textContent = sessionLabel(selected);
		endError.hidden = true;
		const remove = selected.state === 'exited';
		endTitle.textContent = remove ? 'Remove this session?' : 'End this session?';
		endCopy.childNodes[0]!.textContent = remove ? 'The finished session record ' : 'The shell and jobs attached to ';
		endCopy.childNodes[2]!.textContent = remove ? ' will be removed from this list.' : ' will stop. It cannot be resumed.';
		endButton.textContent = remove ? 'Remove session' : 'End session';
		endDialog.showModal();
	});

	endButton.addEventListener('click', async () => {
		if (!selected) return;
		const ending = selected;
		const generation = runnerGeneration;
		endError.hidden = true;
		const remove = ending.state === 'exited';
		const endpoint = '/api/sessions/' + encodeURIComponent(ending.id) + (remove ? '' : '/stop');
		let response: Response;
		try {
			response = await api(endpoint, { method: remove ? 'DELETE' : 'POST' }, generation);
		} catch (error) {
			if (staleRunnerRequest(error, generation) || selected?.id !== ending.id) return;
			endError.textContent = 'The runner could not ' + (remove ? 'remove' : 'end') + ' this session.';
			endError.hidden = false;
			return;
		}
		if (generation !== runnerGeneration || selected?.id !== ending.id) return;
		if (!response.ok) {
			endError.textContent = 'The runner could not ' + (remove ? 'remove' : 'end') + ' this session.';
			endError.hidden = false;
			return;
		}
		sessionLoadGeneration += 1;
		if (remove) {
			sessions = sessions.filter((item) => item.id !== ending.id);
		} else {
			ending.state = 'exited';
			ending.exitedAt = new Date().toISOString();
			ending.writable = false;
		}
		selected = undefined;
		endDialog.close();
		renderSessions();
		showEmpty();
	});

	reconnectButton.addEventListener('click', () => {
		if (!selected) return;
		reconnectAttempts = 0;
		connectSocket(selected);
	});

	takeControlButton.addEventListener('click', () => {
		send({ type: 'take-control' });
		connectionState('connecting', 'Requesting control');
	});

	function setSidebarOpen(open: boolean) {
		const expanded = mobileSidebar.matches && open;
		sidebar.classList.toggle('is-open', expanded);
		scrim.classList.toggle('is-open', expanded);
		sidebarToggle.setAttribute('aria-expanded', String(expanded));
		sidebarToggle.setAttribute('aria-label', expanded ? 'Close sessions' : 'Open sessions');
		if (mobileSidebar.matches && !expanded) {
			sidebar.setAttribute('inert', '');
			sidebar.setAttribute('aria-hidden', 'true');
		} else {
			sidebar.removeAttribute('inert');
			sidebar.removeAttribute('aria-hidden');
		}
	}
	function openSidebar() {
		if (!mobileSidebar.matches) return;
		setSidebarOpen(true);
		requestAnimationFrame(() => element<HTMLButtonElement>('new-session-side').focus());
	}
	function closeSidebar(restoreFocus = true) {
		const wasOpen = sidebar.classList.contains('is-open');
		if (restoreFocus && wasOpen) sidebarToggle.focus();
		setSidebarOpen(false);
	}
	sidebarToggle.addEventListener('click', () => sidebar.classList.contains('is-open') ? closeSidebar() : openSidebar());
	scrim.addEventListener('click', () => closeSidebar());
	mobileSidebar.addEventListener('change', () => closeSidebar(false));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && sidebar.classList.contains('is-open')) {
			event.preventDefault();
			closeSidebar();
		}
	});
	setSidebarOpen(false);
	loginScreen.addEventListener('cancel', (event) => event.preventDefault());

	document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => {
		button.addEventListener('click', () => button.closest('dialog')?.close());
	});

	if (notificationsEnabled && (!notificationsSupported() || Notification.permission !== 'granted')) {
		notificationsEnabled = false;
		writeStorage(localStorage, NOTIFICATION_KEY, 'false');
	} else if (notificationsEnabled) {
		void notificationServiceWorker().catch(() => {
			notificationsEnabled = false;
			writeStorage(localStorage, NOTIFICATION_KEY, 'false');
		});
	}

	window.setInterval(() => {
		if (!loginScreen.open) void loadSessions().catch((error) => {
			if (!(error instanceof StaleRunnerRequest)) runnerState('offline', 'Unavailable');
		});
	}, 15000);
	bootstrap();
</script>
