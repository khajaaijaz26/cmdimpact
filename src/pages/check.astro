---
import { getCollection } from 'astro:content';
import AdSlot from '../components/AdSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const products = (await getCollection('products')).map((entry) => entry.data).sort((a, b) => a.name.localeCompare(b.name));
const toolProducts = products.map(({ id, name, brand, power, network, ecosystems, ecosystemCoverage, storage, subscription, internet }) => ({
	id, name, brand, power, network, ecosystems, ecosystemCoverage, storage, subscription, internet,
}));
const serializedProducts = JSON.stringify(toolProducts).replaceAll('<', '\\u003c');
---

<BaseLayout title="Compatibility checker" description="Use your setup to check verified technology for blockers, limits and unknown compatibility facts.">
	<section class="page-hero">
		<div class="container page-hero-grid">
			<div><div class="scope-line"><span class="live-pulse"></span> Live module · Smart home / Video doorbells</div><p class="eyebrow">01 / Match</p><h1>Does it fit your world?</h1></div>
			<p class="lede">Set the requirements that matter. CompatNavi separates hard blockers, practical limits and facts the manufacturer has not made clear.</p>
		</div>
	</section>
	<div class="container module-bar"><div><span>ACTIVE DATASET</span><strong>{products.length} verified video doorbells</strong></div><p>The universal checker opens one category only when its evidence rules are ready.</p><a href="/categories/">All categories ↗</a></div>

	<section class="container tool-layout">
		<div class="panel sticky-panel">
			<div class="panel-head"><h2>Your setup</h2><p>Choose “No preference” when a detail does not matter to you.</p></div>
			<form id="fit-form" class="form-stack">
				<div class="form-field">
					<label for="product">Product</label>
					<select id="product" name="product">
						<option value="all">Rank every product</option>
						{products.map((product) => <option value={product.id}>{product.brand} — {product.name}</option>)}
					</select>
				</div>
				<div class="form-field">
					<label for="power">Power available</label>
					<select id="power" name="power">
						<option value="any">No preference</option>
						<option value="battery">Battery / no wires</option>
						<option value="wired">Existing doorbell wiring</option>
						<option value="poe">Power over Ethernet</option>
					</select>
				</div>
				<div class="form-field">
					<label for="network">Network available at the door</label>
					<select id="network" name="network">
						<option value="any">No preference / not sure</option>
						<option value="wifi-2.4">2.4 GHz Wi-Fi</option>
						<option value="wifi-5">5 GHz-only Wi-Fi</option>
						<option value="ethernet">Ethernet cable</option>
					</select>
					<span class="field-help">“5 GHz-only” means a 2.4 GHz device cannot join your network.</span>
				</div>
				<div class="form-field">
					<label for="ecosystem">Smart-home platform</label>
					<select id="ecosystem" name="ecosystem">
						<option value="any">No preference</option>
						<option value="alexa">Amazon Alexa</option>
						<option value="google-home">Google Home</option>
						<option value="apple-home">Apple Home</option>
					</select>
				</div>
				<div class="form-field">
					<label for="storage">Recording storage needed</label>
					<select id="storage" name="storage">
						<option value="any">No preference</option>
						<option value="local">Local storage</option>
						<option value="cloud">Cloud storage</option>
					</select>
				</div>
				<div class="form-field">
					<label for="subscription">Paid subscription</label>
					<select id="subscription" name="subscription">
						<option value="avoid">I want to avoid one</option>
						<option value="okay">A subscription is okay</option>
					</select>
				</div>
				<div class="form-field">
					<label for="offline">Internet-outage behavior</label>
					<select id="offline" name="offline">
						<option value="not-important">Not important</option>
						<option value="important">Some local use is important</option>
					</select>
				</div>
				<div class="form-actions">
					<button class="button" type="submit">Show my matches</button>
					<button class="button secondary" id="reset-profile" type="button">Reset</button>
				</div>
				<p class="privacy-note">Saved only in this browser. Nothing is sent to a server.</p>
			</form>
		</div>

		<div>
			<div id="passport-context" class="passport-context" hidden><span>TECH PASSPORT</span><p id="passport-message"></p><a href="/passport/">Edit profile</a></div>
			<div id="fit-empty" class="empty-state">
				<div>
					<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18"/><path d="M16 24h16M24 16v16"/></svg>
					<h2>Ready when you are</h2>
					<p>Complete your setup and the verdicts will appear here.</p>
				</div>
			</div>
			<div id="fit-output" hidden>
				<div class="panel-head"><p class="eyebrow">Your results</p><h2 id="fit-summary" aria-live="polite"></h2><p>Open a product to inspect its sources before making a final purchase decision.</p></div>
				<div id="fit-results" class="results-stack"></div>
			</div>
			<noscript><p class="notice">The fit checker needs JavaScript. The product catalog and cited facts remain available without it.</p></noscript>
		</div>
	</section>

	<section class="section tint">
		<div class="container narrow prose">
			<h2>How to read a verdict</h2>
			<p><strong>Fits</strong> means every requirement you selected matches a verified product fact. <strong>Fits with limits</strong> means it can work, but an integration, paid plan or outage dependency may matter. <strong>Doesn't fit</strong> means at least one selected requirement is unsupported. <strong>Unknown</strong> means the manufacturer source did not answer an important question.</p>
			<p><a href="/methodology/">Read the full methodology</a>.</p>
			<AdSlot />
		</div>
	</section>

	<script is:inline id="fit-products" type="application/json" set:html={serializedProducts}></script>
	<script>
		import { evaluateFit, type FitProduct, type Preferences } from '../lib/fit';

		const products = JSON.parse(document.querySelector('#fit-products')?.textContent || '[]') as FitProduct[];
		const form = document.querySelector<HTMLFormElement>('#fit-form');
		const empty = document.querySelector<HTMLElement>('#fit-empty');
		const output = document.querySelector<HTMLElement>('#fit-output');
		const results = document.querySelector<HTMLElement>('#fit-results');
		const summary = document.querySelector<HTMLElement>('#fit-summary');
		const reset = document.querySelector<HTMLButtonElement>('#reset-profile');
		const storageKey = 'compatnavi-profile-v1';
		const passportKey = 'compatnavi-passport-v1';

		function restoreProfile() {
			if (!form) return;
			try {
				const saved = JSON.parse(localStorage.getItem(storageKey) || '{}') as Record<string, unknown>;
				for (const name of ['power', 'network', 'ecosystem', 'storage', 'subscription', 'offline']) {
					const select = form.elements.namedItem(name) as HTMLSelectElement | null;
					const value = saved[name];
					if (select && typeof value === 'string' && [...select.options].some((option) => option.value === value)) select.value = value;
				}
			} catch {
				localStorage.removeItem(storageKey);
			}
		}

		function applyPassport() {
			if (!form) return;
			try {
				const saved = JSON.parse(localStorage.getItem(passportKey) || 'null') as { country?: unknown; platforms?: unknown } | null;
				if (!saved) return;
				const mapping: Record<string, Preferences['ecosystem']> = { alexa: 'alexa', 'google-home': 'google-home', 'apple-home': 'apple-home' };
				const homePlatforms = Array.isArray(saved.platforms) ? saved.platforms.filter((item): item is string => typeof item === 'string' && item in mapping) : [];
				const ecosystem = form.elements.namedItem('ecosystem') as HTMLSelectElement | null;
				if (ecosystem?.value === 'any' && homePlatforms.length === 1) ecosystem.value = mapping[homePlatforms[0]];
				const context = document.querySelector<HTMLElement>('#passport-context');
				const message = document.querySelector<HTMLElement>('#passport-message');
				const market = typeof saved.country === 'string' && saved.country.trim() ? saved.country.trim() : 'your market';
				if (message) message.textContent = homePlatforms.length === 1
					? `Prefilled your home platform. Product evidence is still labelled by source region for ${market}.`
					: `Using ${market} as context. Choose the home platform needed for this check.`;
				if (context) context.hidden = false;
			} catch { localStorage.removeItem(passportKey); }
		}

		function addResult(product: FitProduct, preferences: Preferences) {
			if (!results) return;
			const verdict = evaluateFit(product, preferences);
			const card = document.createElement('article');
			card.className = 'result-card';
			card.dataset.status = verdict.status;

			const top = document.createElement('div');
			top.className = 'result-top';
			const heading = document.createElement('div');
			const brand = document.createElement('p');
			brand.className = 'result-brand';
			brand.textContent = product.brand;
			const title = document.createElement('h3');
			title.className = 'result-title';
			title.textContent = product.name;
			heading.append(brand, title);
			const badge = document.createElement('span');
			badge.className = 'verdict';
			badge.dataset.status = verdict.status;
			badge.textContent = verdict.label;
			top.append(heading, badge);

			const list = document.createElement('ul');
			list.className = 'reason-list';
			for (const detail of verdict.details) {
				const item = document.createElement('li');
				item.dataset.kind = detail.kind;
				item.textContent = detail.text;
				list.append(item);
			}

			const link = document.createElement('a');
			link.className = 'text-link';
			link.href = `/products/${encodeURIComponent(product.id)}/`;
			link.textContent = 'See facts and sources →';
			card.append(top, list, link);
			results.append(card);
			return verdict;
		}

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const values = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const preferences: Preferences = {
				power: values.power as Preferences['power'],
				network: values.network as Preferences['network'],
				ecosystem: values.ecosystem as Preferences['ecosystem'],
				storage: values.storage as Preferences['storage'],
				subscription: values.subscription as Preferences['subscription'],
				offline: values.offline as Preferences['offline'],
			};
			localStorage.setItem(storageKey, JSON.stringify(preferences));

			const selected = values.product === 'all' ? products : products.filter((product) => product.id === values.product);
			const ranked = selected
				.map((product) => ({ product, verdict: evaluateFit(product, preferences) }))
				.sort((a, b) => b.verdict.score - a.verdict.score || a.product.name.localeCompare(b.product.name));
			if (results) results.textContent = '';
			for (const item of ranked) addResult(item.product, preferences);
			if (summary) summary.textContent = values.product === 'all' ? `${ranked.length} products ranked for your setup` : 'Compatibility result';
			if (empty) empty.hidden = true;
			if (output) output.hidden = false;
			output?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
		});

		reset?.addEventListener('click', () => {
			form?.reset();
			localStorage.removeItem(storageKey);
			if (results) results.textContent = '';
			if (empty) empty.hidden = false;
			if (output) output.hidden = true;
		});

		restoreProfile();
		applyPassport();
		const requestedProduct = new URLSearchParams(location.search).get('product');
		const productSelect = form?.elements.namedItem('product') as HTMLSelectElement | null;
		if (requestedProduct && productSelect && [...productSelect.options].some((option) => option.value === requestedProduct)) {
			productSelect.value = requestedProduct;
			form?.requestSubmit();
		}
	</script>
</BaseLayout>
