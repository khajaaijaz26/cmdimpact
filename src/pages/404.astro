---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested CompatNavi page could not be found." noIndex>
	<section class="hero">
		<div class="container narrow">
			<p class="eyebrow">404 · Route not found</p>
			<h1>This node is not connected.</h1>
			<p class="lede">The page may have moved, the link may be incomplete, or that technology category is not live yet.</p>
			<div class="button-row"><a class="button" href="/">Return to the network</a><a class="button secondary" href="/categories/">Open technology atlas</a></div>
		</div>
	</section>
</BaseLayout>
