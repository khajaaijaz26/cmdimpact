---
import { getCollection } from 'astro:content';
import ProductCard from '../../components/ProductCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = (await getCollection('products')).map((entry) => entry.data).sort((a, b) => a.brand.localeCompare(b.brand) || a.name.localeCompare(b.name));
const brands = [...new Set(products.map((product) => product.brand))].sort();
---

<BaseLayout title="Verified technology catalog" description="Browse technology with sourced compatibility facts, named market coverage, review dates and practical limitations.">
	<section class="page-hero">
		<div class="container page-hero-grid">
			<div><div class="scope-line"><span class="live-pulse"></span> Category 01 · Live</div><p class="eyebrow">Verified catalog</p><h1>Technology with receipts.</h1></div>
			<p class="lede">The catalog will span technology categories worldwide. The current verified dataset is smart video doorbells, with facts checked against manufacturer pages for the named market.</p>
		</div>
	</section>
	<div class="container module-bar"><div><span>BROWSING</span><strong>Smart home → Video doorbells</strong></div><p>{products.length} models · United States and Global English evidence regions</p><a href="/categories/">Change category ↗</a></div>

	<section class="container">
		<div class="catalog-controls" aria-label="Product filters">
			<div class="form-field"><label for="catalog-search">Search</label><input id="catalog-search" type="search" placeholder="Brand or product name" autocomplete="off" /></div>
			<div class="form-field"><label for="brand-filter">Brand</label><select id="brand-filter"><option value="all">All brands</option>{brands.map((brand) => <option value={brand}>{brand}</option>)}</select></div>
			<div class="form-field"><label for="power-filter">Power</label><select id="power-filter"><option value="all">Any power</option><option value="battery">Battery</option><option value="wired">Doorbell wiring</option><option value="poe">PoE</option></select></div>
			<div class="form-field"><label for="storage-filter">Recording</label><select id="storage-filter"><option value="all">Any storage</option><option value="local">Local</option><option value="cloud">Cloud</option></select></div>
		</div>
		<p class="results-count" id="catalog-count" aria-live="polite">Showing all {products.length} verified products</p>
		<div class="product-grid" id="product-grid">
			{products.map((product) => <ProductCard product={product} />)}
		</div>
		<p class="empty-state" id="catalog-empty" hidden>No products match those filters. Try removing one requirement or use the <a href="/check/">fit checker</a>.</p>
	</section>

	<section class="section">
		<div class="container cta-band"><div><h2>Filters show facts. The checker gives a verdict.</h2><p>Rank the whole catalog against several requirements at once.</p></div><a class="button" href="/check/">Use fit checker</a></div>
	</section>

	<script>
		const search = document.querySelector<HTMLInputElement>('#catalog-search');
		const brand = document.querySelector<HTMLSelectElement>('#brand-filter');
		const power = document.querySelector<HTMLSelectElement>('#power-filter');
		const storage = document.querySelector<HTMLSelectElement>('#storage-filter');
		const cards = [...document.querySelectorAll<HTMLElement>('[data-product-card]')];
		const count = document.querySelector<HTMLElement>('#catalog-count');
		const empty = document.querySelector<HTMLElement>('#catalog-empty');

		function updateCatalog() {
			const query = search?.value.trim().toLowerCase() || '';
			let visible = 0;
			for (const card of cards) {
				const storageValues = card.dataset.storage?.split(' ') || [];
				const storageMatches = storage?.value === 'all'
					|| (storage?.value === 'cloud' ? storageValues.includes('cloud') : storageValues.some((value) => value !== 'cloud'));
				const matches = (!query || card.dataset.search?.includes(query))
					&& (brand?.value === 'all' || card.dataset.brand === brand?.value)
					&& (power?.value === 'all' || card.dataset.power?.split(' ').includes(power?.value || ''))
					&& storageMatches;
				card.hidden = !matches;
				if (matches) visible += 1;
			}
			if (count) count.textContent = visible === cards.length ? `Showing all ${visible} products` : `Showing ${visible} of ${cards.length} products`;
			if (empty) empty.hidden = visible !== 0;
		}

		search?.addEventListener('input', updateCatalog);
		brand?.addEventListener('change', updateCatalog);
		power?.addEventListener('change', updateCatalog);
		storage?.addEventListener('change', updateCatalog);
	</script>
</BaseLayout>
