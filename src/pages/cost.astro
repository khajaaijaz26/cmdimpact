---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="True cost calculator" description="Calculate the real multi-year cost of smart technology, including hardware, installation, accessories and monthly subscriptions.">
	<section class="page-hero">
		<div class="container narrow">
			<p class="eyebrow">Ownership cost tool</p>
			<h1>See the price after the price tag.</h1>
			<p class="lede">A cheaper device can cost more after installation, storage and subscriptions. Add the numbers for your shortlist and compare on the same time horizon.</p>
		</div>
	</section>

	<section class="container calculator-layout">
		<div class="panel">
			<div class="panel-head"><h2>Your numbers</h2><p>Sample values are included to show the calculator. Replace them with current prices from your region.</p></div>
			<form id="cost-form" class="form-stack">
				<div class="field-grid">
					<div class="form-field"><label for="currency">Currency</label><select id="currency" name="currency"><option value="USD">USD — $</option><option value="AED">AED — د.إ</option><option value="EUR">EUR — €</option><option value="GBP">GBP — £</option><option value="INR">INR — ₹</option></select></div>
					<div class="form-field"><label for="years">Ownership period</label><select id="years" name="years"><option value="1">1 year</option><option value="3" selected>3 years</option><option value="5">5 years</option><option value="10">10 years</option></select></div>
					<div class="form-field"><label for="hardwarePrice">Price per device</label><input id="hardwarePrice" name="hardwarePrice" type="number" min="0" step="0.01" value="150" inputmode="decimal" /></div>
					<div class="form-field"><label for="quantity">Number of devices</label><input id="quantity" name="quantity" type="number" min="1" max="100" step="1" value="1" inputmode="numeric" /></div>
					<div class="form-field"><label for="accessories">Accessories and storage</label><input id="accessories" name="accessories" type="number" min="0" step="0.01" value="30" inputmode="decimal" /><span class="field-help">Chime, transformer, microSD card, hub or PoE equipment.</span></div>
					<div class="form-field"><label for="installation">Installation</label><input id="installation" name="installation" type="number" min="0" step="0.01" value="0" inputmode="decimal" /></div>
					<div class="form-field"><label for="monthlySubscription">Subscription per month</label><input id="monthlySubscription" name="monthlySubscription" type="number" min="0" step="0.01" value="5" inputmode="decimal" /></div>
					<div class="form-field"><label for="monthlyOther">Other monthly cost</label><input id="monthlyOther" name="monthlyOther" type="number" min="0" step="0.01" value="0" inputmode="decimal" /><span class="field-help">Optional monitoring, extra cloud plan or connectivity.</span></div>
				</div>
				<p class="privacy-note">Calculated on your device. No values are stored or transmitted.</p>
			</form>
		</div>

		<aside class="panel cost-summary" aria-live="polite">
			<div class="cost-total"><span id="period-label">3-year true cost</span><strong id="grand-total">$0.00</strong><p><span id="monthly-equivalent">$0.00</span> effective monthly cost</p></div>
			<dl class="cost-breakdown">
				<div><dt>Hardware</dt><dd id="hardware-total">$0.00</dd></div>
				<div><dt>Total upfront</dt><dd id="upfront-total">$0.00</dd></div>
				<div><dt>Recurring over period</dt><dd id="recurring-total">$0.00</dd></div>
			</dl>
		</aside>
	</section>

	<section class="section tint">
		<div class="container narrow prose">
			<h2>Numbers people commonly miss</h2>
			<ul><li>A transformer, indoor chime, mounting wedge, microSD card, NVR or home hub.</li><li>Professional electrical or Ethernet installation.</li><li>A plan needed to review recordings rather than only watch live video.</li><li>Price changes after an introductory trial or bundled period ends.</li></ul>
			<blockquote><p>Use the same ownership period and include equivalent capabilities when comparing two products.</p></blockquote>
		</div>
	</section>

	<script>
		import { calculateOwnershipCost } from '../lib/cost';

		const form = document.querySelector<HTMLFormElement>('#cost-form');
		const get = (name: string) => Number((form?.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value || 0);
		const set = (selector: string, text: string) => { const element = document.querySelector<HTMLElement>(selector); if (element) element.textContent = text; };

		function updateCost() {
			if (!form) return;
			const result = calculateOwnershipCost({
				hardwarePrice: get('hardwarePrice'), quantity: get('quantity'), accessories: get('accessories'),
				installation: get('installation'), monthlySubscription: get('monthlySubscription'),
				monthlyOther: get('monthlyOther'), years: get('years'),
			});
			const currency = (form.elements.namedItem('currency') as HTMLSelectElement).value;
			const format = new Intl.NumberFormat(undefined, { style: 'currency', currency, maximumFractionDigits: 2 });
			set('#period-label', `${result.years}-year true cost`);
			set('#grand-total', format.format(result.total));
			set('#monthly-equivalent', format.format(result.monthlyEquivalent));
			set('#hardware-total', format.format(result.hardware));
			set('#upfront-total', format.format(result.upfront));
			set('#recurring-total', format.format(result.recurring));
		}

		form?.addEventListener('input', updateCost);
		form?.addEventListener('submit', (event) => event.preventDefault());
		updateCost();
	</script>
</BaseLayout>
