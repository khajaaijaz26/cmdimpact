---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = (await getCollection('guides')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf() || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Compatibility guides" description="Practical guides to smart-doorbell Wi-Fi, power, storage, subscriptions and true ownership cost.">
	<section class="page-hero">
		<div class="container narrow"><p class="eyebrow">Decision library</p><h1>Understand the detail that changes the answer.</h1><p class="lede">Plain-language guides for the questions that appear after “Does it have a camera?” and before “Why doesn't this work?”</p></div>
	</section>
	<section class="container">
		<div class="guide-grid">
			{guides.map((guide) => (
				<article class="guide-card">
					<div class="guide-meta"><span>{guide.data.readingTime}</span><span>Updated {guide.data.updatedAt.toLocaleDateString('en-US', { dateStyle: 'medium' })}</span></div>
					<h2><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h2>
					<p>{guide.data.description}</p>
					<div class="chip-row">{guide.data.topics.map((topic) => <span class="chip">{topic}</span>)}</div>
					<a class="text-link" href={`/guides/${guide.id}/`}>Read guide <span aria-hidden="true">→</span></a>
				</article>
			))}
		</div>
	</section>
	<section class="section"><div class="container cta-band"><div><h2>Ready to use the facts?</h2><p>Turn your requirements into a ranked product list.</p></div><a class="button" href="/check/">Check my setup</a></div></section>
</BaseLayout>
