---
import AdSlot from '../../components/AdSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
	{ topic: 'Bash · 4 min', title: 'Why “curl | sh” deserves a pause', description: 'Understand what crosses the pipe and how to inspect an installer before choosing to run it.', href: '/guides/curl-pipe-shell/' },
	{ topic: 'PowerShell · 4 min', title: 'What “iwr | iex” does', description: 'Decode a common compact installer and separate downloading from execution.', href: '/guides/powershell-iwr-iex/' },
	{ topic: 'Packages · 5 min', title: 'How to check a package suggested by AI', description: 'Confirm the name, publisher, source, version and scope before installation.', href: '/guides/check-ai-package/' },
];
---

<BaseLayout title="Command safety guides" description="Plain-English guides for terminal commands commonly suggested by ChatGPT, Claude, Codex, Copilot and GitHub projects." allowAds={true}>
	<header class="page-hero"><div class="shell"><p class="kicker">CmdImpact / Guides</p><h1>Understand before you run.</h1><p class="page-lede">Short, source-linked explanations for the commands and installation patterns people copy from AI answers and GitHub projects.</p></div></header>
	<section class="shell guide-index">
		<div class="guide-grid">
			{guides.map((guide) => <article class="guide-card"><p class="kicker">{guide.topic}</p><h2>{guide.title}</h2><p>{guide.description}</p><a href={guide.href}>Read the guide →</a></article>)}
		</div>
		<AdSlot />
	</section>
</BaseLayout>
