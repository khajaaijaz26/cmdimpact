---
import { labels } from '../lib/fit';

interface Props {
	product: any;
}

const { product } = Astro.props;
const localStorage = product.storage.some((item: string) => item !== 'cloud');
const network = product.network.length
	? product.network.map((item: keyof typeof labels.network) => labels.network[item]).join(' + ')
	: 'Network not confirmed';
---

<article
	class="product-card"
	data-product-card
	data-search={`${product.brand} ${product.name} ${product.model}`.toLowerCase()}
	data-brand={product.brand}
	data-power={product.power.join(' ')}
	data-storage={product.storage.join(' ')}
>
	<div class="product-card-top">
		<div class="product-monogram" aria-hidden="true">{product.brand.slice(0, 1)}</div>
		<div>
			<p class="card-kicker">{product.brand}</p>
			<h2><a href={`/products/${product.id}/`}>{product.name}</a></h2>
		</div>
	</div>
	<p>{product.summary}</p>
	<div class="chip-row" aria-label="Key compatibility facts">
		<span class="chip">{product.power.map((item: keyof typeof labels.power) => labels.power[item]).join(' + ')}</span>
		<span class="chip">{localStorage ? 'Local recording' : 'Cloud recording'}</span>
	</div>
	<dl class="card-facts">
		<div><dt>Network</dt><dd>{network}</dd></div>
		<div><dt>Paid plan</dt><dd>{product.subscription === 'recordings' ? 'For recordings' : product.subscription === 'optional' ? 'Optional' : 'Not required'}</dd></div>
	</dl>
	<a class="text-link" href={`/products/${product.id}/`}>See verified facts <span aria-hidden="true">→</span></a>
</article>
