---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const toolActive = ['/tools/', '/check/', '/compare/', '/cost/'].some((href) => pathname.startsWith(href));
const mobileLinks = [
	{ href: '/', label: 'Home', note: 'Start here' },
	{ href: '/categories/', label: 'Explore', note: 'Technology atlas' },
	{ href: '/products/', label: 'Catalog', note: 'Verified products' },
	{ href: '/tools/', label: 'Tools', note: 'Check, compare, calculate' },
	{ href: '/guides/', label: 'Guides', note: 'Understand the details' },
];
---

<div class="world-strip">
	<div class="container">
		<span><i class="live-pulse"></i> Built for every market and major platform</span>
		<a href="/categories/">1 verified category live · View coverage</a>
	</div>
</div>
<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="CompatNavi home"><Logo /></a>
		<nav class="primary-nav" aria-label="Main navigation">
			<a href="/categories/" aria-current={isCurrent('/categories/') ? 'page' : undefined}>Explore</a>
			<a href="/products/" aria-current={isCurrent('/products/') ? 'page' : undefined}>Catalog</a>
			<details class:list={['nav-tools', toolActive && 'is-current']}>
				<summary>Tools <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
				<div class="tools-popover">
					<a href="/tools/"><span>00</span><strong>All tools</strong><small>Open the utility deck</small></a>
					<a href="/check/"><span>01</span><strong>Fit checker</strong><small>Find blockers and limits</small></a>
					<a href="/compare/"><span>02</span><strong>Compare</strong><small>See facts side by side</small></a>
					<a href="/cost/"><span>03</span><strong>True cost</strong><small>Calculate ownership cost</small></a>
				</div>
			</details>
			<a href="/guides/" aria-current={isCurrent('/guides/') ? 'page' : undefined}>Guides</a>
		</nav>
		<div class="header-actions">
			<button class="icon-button theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"/></svg>
			</button>
			<a class="passport-button" href="/passport/" aria-current={isCurrent('/passport/') ? 'page' : undefined}><span class="passport-dot" aria-hidden="true"></span> My Tech Passport</a>
			<details class="mobile-menu">
				<summary class="menu-trigger" aria-label="Open navigation"><span></span><span></span></summary>
				<div class="mobile-sheet">
					<div class="mobile-sheet-head"><span>Navigate CompatNavi</span><small>CN / GLOBAL</small></div>
					<nav aria-label="Mobile navigation">
						{mobileLinks.map((link, index) => (
							<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><span>0{index + 1}</span><strong>{link.label}</strong><small>{link.note}</small></a>
						))}
					</nav>
					<a class="button" href="/passport/">Open my Tech Passport</a>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	button?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('compatnavi-theme', next);
		button.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} theme`);
	});
</script>
