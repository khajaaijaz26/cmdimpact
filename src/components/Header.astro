---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && pathname.startsWith(href);
const links = [
	{ href: '/#checker', label: 'Check a command' },
	{ href: '/methodology/', label: 'How it works' },
	{ href: '/guides/', label: 'Guides' },
	{ href: '/about/', label: 'About' },
];
---

<div class="trust-strip">
	<div class="shell"><span><i></i> Nothing is executed</span><span>Local analysis · No account</span></div>
</div>
<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/" aria-label="CmdImpact home"><Logo /></a>
		<nav class="desktop-nav" aria-label="Main navigation">
			{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
		</nav>
		<div class="header-actions">
			<button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
				<svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
				<svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"/></svg>
			</button>
			<a class="header-cta" href="/#checker">Check now <span aria-hidden="true">→</span></a>
			<details class="mobile-menu">
				<summary aria-label="Open navigation"><span></span><span></span></summary>
				<nav aria-label="Mobile navigation">
					{links.map((link) => <a href={link.href}>{link.label}</a>)}
					<a href="https://github.com/khajaaijaz26/cmdimpact" rel="external noopener">GitHub ↗</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
	toggle?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('cmdimpact-theme', next);
	});
</script>
