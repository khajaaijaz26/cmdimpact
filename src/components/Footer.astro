---
import Logo from './Logo.astro';
---

<footer class="site-footer">
	<div class="shell footer-main">
		<div class="footer-brand">
			<a class="brand" href="/" aria-label="CmdImpact home"><Logo /></a>
			<p>The single-owner, self-hosted terminal that keeps your sessions within reach.</p>
		</div>
		<nav aria-label="Product links">
			<strong>Product</strong>
			<a href="/#product">Terminal workspace</a>
			<a href="/check/">Command guard</a>
			<a href="/methodology/">How checks work</a>
			<a href="/guides/">Guides</a>
		</nav>
		<nav aria-label="Project links">
			<strong>Project</strong>
			<a href="/about/">About</a>
			<a href="https://github.com/khajaaijaz26/cmdimpact" rel="external noopener">GitHub</a>
			<a href="/contact/">Report a problem</a>
		</nav>
		<nav aria-label="Policy links">
			<strong>Legal</strong>
			<a href="/privacy/">Privacy</a>
			<a href="/terms/">Terms</a>
			<a href="/advertising/">Sponsorship</a>
		</nav>
	</div>
	<div class="shell footer-bottom">
		<span>&copy; {new Date().getFullYear()} CmdImpact</span>
		<span>Open-source alpha. Use only on machines you control.</span>
	</div>
</footer>
