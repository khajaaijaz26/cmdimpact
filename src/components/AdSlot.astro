---
const sponsorName = import.meta.env.PUBLIC_SPONSOR_NAME?.trim();
const sponsorText = import.meta.env.PUBLIC_SPONSOR_TEXT?.trim();
const rawSponsorUrl = import.meta.env.PUBLIC_SPONSOR_URL?.trim();
let sponsorUrl: string | undefined;

try {
	const url = new URL(rawSponsorUrl);
	if (url.protocol === 'https:') sponsorUrl = url.href;
} catch {
	// Missing or invalid configuration keeps the placement disabled.
}
---

{sponsorName && sponsorText && sponsorUrl && (
	<aside class="ad-shell" aria-label="Sponsored content">
		<span>Sponsored</span>
		<a href={sponsorUrl} target="_blank" rel="sponsored noopener noreferrer">
			<strong>{sponsorName}</strong>
			<p>{sponsorText}</p>
		</a>
	</aside>
)}
