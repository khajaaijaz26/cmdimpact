# Run `npm run setup` to create `.env` and generate the owner access token.
# Never commit the generated `.env` file.

# Local all-in-one dashboard + runner defaults. For the global dashboard, run:
# npm run setup -- --origin https://YOUR-VERCEL-DOMAIN --workspace /path/to/projects
# An HTTPS origin selects production mode; HTTP is accepted only for loopback use.
PUBLIC_SITE_URL=http://localhost:4321
TERMINAL_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
TERMINAL_ALLOW_INSECURE_LOCALHOST=true
TERMINAL_MAX_SESSIONS=4
# Zero disables automatic idle and hard session expiry. The runner must stay online.
TERMINAL_IDLE_MINUTES=0
TERMINAL_HARD_HOURS=0
# Same-origin cookie and cross-site bearer session lifetime.
TERMINAL_COOKIE_HOURS=12
TRUST_PROXY=true

# Optional first-party guide sponsorship, baked into the static site at build time.
# All three are required; only an HTTPS destination is rendered. No sponsor script loads.
# PUBLIC_SPONSOR_NAME=Example sponsor
# PUBLIC_SPONSOR_TEXT=A short, clearly identified sponsor message.
# PUBLIC_SPONSOR_URL=https://example.com/
